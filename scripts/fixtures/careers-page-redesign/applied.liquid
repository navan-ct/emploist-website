<div class="container confirmation">
  <div class="confirmation-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  </div>
  <h1 class="page-title">Application sent</h1>
  <p class="confirmation-text">
    Thank you for applying for {{ job.title }}. We'll review your application and get in touch if it's a good fit.
  </p>
  <a class="button" href="{{ jobs_url }}">See other open roles</a>
</div>
