---
import { Font, fontData } from "astro:assets";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Seo, { type SeoProps } from "../components/Seo.astro";
import { getLocale, getMessages } from "../i18n";
import { LOCALES, type Locale, localizePath, splitPath } from "../i18n/locales";
import "../styles/global.css";

interface Props extends SeoProps {
  /**
   * The page's address in each language, for the language switcher and
   * search engines. Pages in every language can leave it out; pages that
   * aren't (like an untranslated post) list only those that exist.
   */
  alternates?: Partial<Record<Locale, string>>;
}

const { alternates, ...seo } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const { path } = splitPath(Astro.url.pathname);

const translations: Partial<Record<Locale, string>> =
  alternates ?? Object.fromEntries(LOCALES.map((option) => [option, localizePath(path, option)]));
// The switcher offers every language: where this page isn't translated, it
// goes to the blog in that language, or its home page.
const switcherLinks = Object.fromEntries(
  LOCALES.map((option) => [
    option,
    translations[option] ?? localizePath(path.startsWith("/blog/") ? "/blog/" : "/", option),
  ]),
) as Record<Locale, string>;

// Each font's first file has the basic Latin letters every page needs. Polish
// and Turkish pages also preload Geist's second, with their extra letters.
const sans = fontData["--font-geist"] ?? [];
const mono = fontData["--font-geist-mono"] ?? [];
const preloads = [
  ...(locale === "pl" || locale === "tr" ? sans.slice(0, 2) : sans.slice(0, 1)),
  ...mono.slice(0, 1),
].flatMap((font) => font.src.slice(0, 1));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Font cssVariable="--font-geist" />
    <Font cssVariable="--font-geist-mono" />
    {preloads.map((src) => <link rel="preload" href={src.url} as="font" type={`font/${src.format}`} crossorigin />)}
    <Seo {...seo} locale={locale} alternates={translations} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={t.site.blogFeedTitle} href={localizePath("/rss.xml", locale)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5f5f5" />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="btn btn-primary sr-only z-50 focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      {t.site.skipToContent}
    </a>
    <div class="rails" aria-hidden="true"></div>
    <Header alternates={switcherLinks} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer alternates={switcherLinks} />
    <script is:inline>
      // The page's motion (see "Motion" in global.css): elements fade up or
      // come into focus as they come into view, numbers count up to their
      // values, looping drawings play only while they're on screen, and
      // the overview's list follows the picture being looked at. Without
      // this script, everything is simply there.
      (() => {
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const observe = (selector, options, callback) => {
          const items = document.querySelectorAll(selector);
          if (!items.length) return;
          if (!("IntersectionObserver" in window)) return items.forEach((item) => callback(item, true));
          const observer = new IntersectionObserver(
            (entries) => entries.forEach((entry) => callback(entry.target, entry.isIntersecting, observer)),
            options,
          );
          items.forEach((item) => observer.observe(item));
        };

        // Fade up, once.
        document.querySelectorAll("[data-stagger]").forEach((group) =>
          [...group.children].forEach((child, i) => child.style.setProperty("--i", String(i))),
        );
        observe("[data-reveal], [data-stagger]", { rootMargin: "0px 0px -10% 0px" }, (el, visible, observer) => {
          if (!visible) return;
          el.classList.add("is-revealed");
          observer?.unobserve(el);
        });

        // Count up, once, in the page's language.
        const lang = document.documentElement.lang;
        const formats = {
          number: new Intl.NumberFormat(lang),
          percent: new Intl.NumberFormat(lang, { style: "percent", maximumFractionDigits: 0 }),
          usd: new Intl.NumberFormat(lang, { style: "currency", currency: "USD", maximumFractionDigits: 0 }),
        };
        const format = (el, value) => {
          const kind = el.dataset.format ?? "number";
          return formats[kind].format(kind === "percent" ? value / 100 : value);
        };
        if (!reduce) {
          document.querySelectorAll("[data-count]").forEach((el) => (el.textContent = format(el, 0)));
          observe("[data-count]", { rootMargin: "0px 0px -10% 0px" }, (el, visible, observer) => {
            if (!visible) return;
            observer?.unobserve(el);
            const target = Number(el.dataset.count);
            const delay = Number(el.dataset.countDelay ?? 0);
            const duration = 1400;
            let start;
            const step = (now) => {
              start ??= now;
              const t = Math.min(1, Math.max(0, (now - start - delay) / duration));
              el.textContent = format(el, Math.round(target * (1 - Math.pow(1 - t, 4))));
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }

        // Play while on screen.
        observe("[data-play]", { rootMargin: "0px 0px -10% 0px" }, (el, visible) => {
          el.classList.toggle("is-playing", visible);
        });

        // The overview: the item whose picture crosses the middle of the
        // window is the current one.
        document.querySelectorAll("[data-overview]").forEach((overview) => {
          const items = [...overview.querySelectorAll("[data-overview-item]")];
          const visuals = [...overview.querySelectorAll("[data-overview-visual]")];
          if (!("IntersectionObserver" in window)) return;
          const observer = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                const index = visuals.indexOf(entry.target);
                items.forEach((item, i) => item.classList.toggle("is-current", i === index));
              }
            },
            { rootMargin: "-50% 0px -50% 0px" },
          );
          visuals.forEach((visual) => observer.observe(visual));
        });
      })();
    </script>
  </body>
</html>
