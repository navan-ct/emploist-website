---
// Terms and Privacy: a table of contents, then the full text.
// Each page passes its sections (in order) and gives every <h2> the same id.
// Translations (src/legal/<language>/) also pass the English version they were
// translated from, and show a notice that the English version applies.
import { getLocale, getMessages, linkTo } from "../i18n";
import { formatDate } from "../i18n/format";
import { DEFAULT_LOCALE } from "../i18n/locales";
import { LEGAL_VERSIONS, type LegalDocument } from "../lib/legal";
import Band from "../components/Band.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  document: LegalDocument;
  title: string;
  description: string;
  sections: readonly { id: string; title: string }[];
  /** Translations only: the date in LEGAL_VERSIONS of the English they were translated from. */
  translatedFrom?: string;
}

const { document, title, description, sections, translatedFrom } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const current = LEGAL_VERSIONS[document];
const isTranslation = locale !== DEFAULT_LOCALE;
const version = isTranslation ? (translatedFrom ?? current) : current;
const english = linkTo(`/${document}/`, 'hreflang="en"');
---

<BaseLayout title={`${title} | Emploist`} description={description}>
  <Band />
  <article class="pt-14 sm:pt-20 lg:pt-24">
    <header class="container-page flex flex-col items-center gap-6 px-5 text-center sm:px-8" data-reveal>
      <p class="tag">{t.footer.legal}</p>
      <h1 class="text-heading" data-reveal="blur" style="--reveal-delay: 80ms">{title}</h1>
      <p class="text-label text-body">{t.legal.lastUpdated(formatDate(version, locale))}</p>
    </header>

    <div class="container-page rule-t rule-b mt-12 sm:mt-16">
      <div class="cells lg:grid-cols-12">
        <nav aria-labelledby="contents" class="border-b border-line lg:col-span-4 lg:border-b-0">
          <div class="px-5 py-10 sm:px-8 lg:sticky lg:top-[calc(var(--header-height)+1.5rem)] lg:max-h-[calc(100dvh-var(--header-height)-3rem)] lg:overflow-y-auto lg:py-12">
            <h2 id="contents" class="text-label text-ink">{t.legal.contents}</h2>
            <ol class="legal-toc mt-5 flex flex-col gap-2.5 text-[0.9375rem] leading-snug tracking-[-0.015em] max-lg:sm:columns-2 max-lg:sm:block">
              {
                sections.map((section, index) => (
                  <li class="flex gap-3 break-inside-avoid max-lg:sm:mb-2.5">
                    <span class="w-5 shrink-0 font-mono text-xs leading-[1.4rem] text-faint tabular-nums">{index + 1}</span>
                    <a href={`#${section.id}`} class="min-w-0 text-body transition-colors hover:text-ink">
                      {section.title}
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
        </nav>

        <div class="px-5 py-10 sm:px-8 sm:py-12 lg:col-span-8 lg:px-12 xl:px-16">
          {
            isTranslation && (
              <aside class="legal-notice mb-10 flex flex-col gap-2 border border-line bg-subtle px-5 py-4 text-sm leading-relaxed">
                <p set:html={t.legal.translationNotice[document](english)} />
                {version !== current && (
                  <p class="text-ink" set:html={t.legal.outdated(formatDate(current, locale), english)} />
                )}
              </aside>
            )
          }
          <div class="prose-post prose prose-zinc max-w-[44rem]">
            <slot />
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>

<script is:inline>
  // Marks the section being read in the contents.
  (() => {
    const links = [...document.querySelectorAll(".legal-toc a")];
    if (!links.length || !("IntersectionObserver" in window)) return;
    const byId = new Map(links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]));
    const headings = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean);
    const visible = new Set();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target);
        const current = headings.find((heading) => visible.has(heading));
        if (!current) return;
        for (const link of links) link.toggleAttribute("aria-current", link === byId.get(current.id));
      },
      { rootMargin: "0px 0px -70% 0px" },
    );
    headings.forEach((heading) => observer.observe(heading));
  })();
</script>

<style>
  .legal-notice :global(a) {
    color: var(--brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal-toc :global(a[aria-current]) {
    color: var(--brand-ink);
  }
</style>
