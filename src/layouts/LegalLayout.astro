---
// Terms and Privacy: a summary, a table of contents, then the full text.
// Each page passes its sections (in order) and gives every <h2> the same id.
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  updated: string;
  sections: readonly { id: string; title: string }[];
}

const { title, description, updated, sections } = Astro.props;
---

<BaseLayout title={`${title} | Emploist`} description={description}>
  <article class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="mx-auto max-w-[44rem]">
      <header>
        <h1 class="text-heading">{title}</h1>
        <p class="mt-4 text-sm text-faint">Last updated {updated}</p>
      </header>

      <section aria-labelledby="summary" class="mt-10 rounded-xl bg-subtle px-5 py-5 ring-1 ring-line sm:px-6">
        <h2 id="summary" class="text-[0.9375rem] font-semibold">The short version</h2>
        <div class="prose-post prose prose-zinc mt-3 max-w-none text-[0.9375rem] prose-li:my-1">
          <slot name="summary" />
        </div>
      </section>

      <nav aria-labelledby="contents" class="mt-10">
        <h2 id="contents" class="text-[0.9375rem] font-semibold">Contents</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-[0.9375rem] marker:text-faint sm:columns-2 sm:gap-8">
          {
            sections.map((section) => (
              <li class="break-inside-avoid">
                <a href={`#${section.id}`} class="underline-offset-4 transition-colors hover:text-ink hover:underline">
                  {section.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="prose-post prose prose-zinc mt-12 max-w-none">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
