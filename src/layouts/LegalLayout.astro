---
// Terms and Privacy: a table of contents, then the full text.
// Each page passes its sections (in order) and gives every <h2> the same id.
// Translations (src/legal/<language>/) also pass the English version they were
// translated from, and show a notice that the English version applies.
import { getLocale, getMessages, linkTo } from "../i18n";
import { formatDate } from "../i18n/format";
import { DEFAULT_LOCALE } from "../i18n/locales";
import { LEGAL_VERSIONS, type LegalDocument } from "../lib/legal";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  document: LegalDocument;
  title: string;
  description: string;
  sections: readonly { id: string; title: string }[];
  /** Translations only: the date in LEGAL_VERSIONS of the English they were translated from. */
  translatedFrom?: string;
}

const { document, title, description, sections, translatedFrom } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const current = LEGAL_VERSIONS[document];
const isTranslation = locale !== DEFAULT_LOCALE;
const version = isTranslation ? (translatedFrom ?? current) : current;
const english = linkTo(`/${document}/`, 'hreflang="en"');
---

<BaseLayout title={`${title} | Emploist`} description={description}>
  <article class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
    <div class="mx-auto max-w-[44rem]">
      <header>
        <h1 class="text-heading">{title}</h1>
        <p class="mt-4 text-sm text-faint">{t.legal.lastUpdated(formatDate(version, locale))}</p>
        {
          isTranslation && (
            <aside class="legal-notice mt-8 flex flex-col gap-2 rounded-xl bg-subtle px-5 py-4 text-sm leading-relaxed ring-1 ring-line">
              <p set:html={t.legal.translationNotice[document](english)} />
              {version !== current && (
                <p class="font-medium text-ink" set:html={t.legal.outdated(formatDate(current, locale), english)} />
              )}
            </aside>
          )
        }
      </header>

      <nav aria-labelledby="contents" class="mt-10">
        <h2 id="contents" class="text-[0.9375rem] font-semibold">{t.legal.contents}</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-[0.9375rem] marker:text-faint sm:columns-2 sm:gap-8">
          {
            sections.map((section) => (
              <li class="break-inside-avoid">
                <a href={`#${section.id}`} class="underline-offset-4 transition-colors hover:text-ink hover:underline">
                  {section.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="prose-post prose prose-zinc mt-12 max-w-none">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-notice :global(a) {
    font-weight: 500;
    color: var(--brand-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
