---
import type { HTMLAttributes } from "astro/types";
import Roll from "./Roll.astro";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  /** `light` and `outline-light` are for dark backgrounds. */
  variant?: "primary" | "secondary" | "ghost" | "light" | "outline-light";
  size?: "md" | "lg";
}

const { href, variant = "primary", size = "md", class: className, ...rest } = Astro.props;
// The label rolls on hover. It's plain text, so undo the slot's escaping.
const label = (await Astro.slots.render("default"))
  .trim()
  .replace(/&(#39|#x27|quot|lt|gt|amp);/g, (_, entity: string) =>
    ({ "#39": "'", "#x27": "'", quot: '"', lt: "<", gt: ">", amp: "&" })[entity] ?? "",
  );
---

<a href={href} class:list={["btn", `btn-${variant}`, size === "lg" && "btn-lg", className]} {...rest}>
  <Roll text={label} wrap={size === "lg"} />
</a>
