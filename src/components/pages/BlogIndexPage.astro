---
// The blog, in the language of its address. Posts that aren't translated
// into it yet are listed in English, marked as such.
import { Image } from "astro:assets";
import { getLocale, getMessages, linkTo } from "../../i18n";
import { formatDate } from "../../i18n/format";
import { DEFAULT_LOCALE, localizePath } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getTranslations, postUrl, readingMinutes } from "../../lib/blog";
import { APP, SITE } from "../../lib/site";
import Button from "../Button.astro";

const locale = getLocale(Astro);
const t = getMessages(locale);
const translations = (await getTranslations()).get(locale);
const posts = (await getPosts()).map((post) => {
  const translation = translations?.get(post.id);
  const entry = translation ?? post;
  return {
    id: post.id,
    data: entry.data,
    url: postUrl(post.id, translation ? locale : DEFAULT_LOCALE),
    minutes: readingMinutes(entry, translation ? locale : DEFAULT_LOCALE),
    inEnglish: locale !== DEFAULT_LOCALE && !translation,
  };
});
const title = `${t.blog.title} | ${SITE.name}`;
const description = t.blog.description;
const blogUrl = new URL(localizePath("/blog/", locale), SITE.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: t.site.blogFeedTitle,
    url: blogUrl,
    inLanguage: locale,
    description,
    publisher: { "@type": "Organization", name: SITE.name, url: `${SITE.url}/` },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: new URL(post.url, SITE.url).href,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
    <header class="max-w-2xl">
      <p class="text-eyebrow">{t.blog.title}</p>
      <h1 class="text-display mt-4">{t.blog.heading}</h1>
      <p class="text-lead mt-6">{description}</p>
    </header>

    {
      posts.length === 0 ? (
        <div class="mt-16 rounded-3xl border border-line bg-subtle px-8 py-14 sm:px-12">
          <h2 class="text-subheading">{t.blog.emptyTitle}</h2>
          <p
            class="mt-3 max-w-xl leading-relaxed [&_a]:font-medium [&_a]:text-brand-ink [&_a]:underline-offset-4 [&_a:hover]:underline"
            set:html={t.blog.emptyText(linkTo(localizePath("/rss.xml", locale)))}
          />
          <div class="mt-8">
            <Button href={APP.signUpUrl}>{t.cta.startYourFreeTrial}</Button>
          </div>
        </div>
      ) : (
        <ul class="mt-16 grid gap-x-8 gap-y-14 border-t border-line pt-14 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <article class="group relative flex flex-col">
                {post.data.image && (
                  <div class="mb-6 overflow-hidden rounded-2xl border border-line bg-subtle">
                    <Image
                      src={post.data.image}
                      alt={post.data.imageAlt ?? ""}
                      widths={[400, 640, 800]}
                      sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 50vw, 100vw"
                      class="aspect-[1200/630] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                )}
                <p class="text-sm text-faint">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
                  <span aria-hidden="true"> · </span>
                  {t.blog.minutesToRead(post.minutes)}
                  {post.inEnglish && (
                    <span class="ml-2 rounded bg-subtle px-1.5 py-0.5 text-xs font-medium text-body ring-1 ring-line">
                      {t.blog.inEnglish}
                    </span>
                  )}
                  {post.data.draft && <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">{t.blog.draft}</span>}
                </p>
                <div lang={post.inEnglish ? "en" : undefined}>
                  <h2 class="mt-3 text-xl font-semibold tracking-[-0.015em]">
                    <a href={post.url} hreflang={post.inEnglish ? "en" : undefined} class="after:absolute after:inset-0">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 leading-relaxed">{post.data.description}</p>
                </div>
                <span class="mt-4 text-[0.9375rem] font-medium text-brand-ink" aria-hidden="true">
                  {t.blog.readPost} →
                </span>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
