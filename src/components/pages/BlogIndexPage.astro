---
// The blog, in the language of its address. Posts that aren't translated
// into it yet are listed in English, marked as such.
import { Image } from "astro:assets";
import { getLocale, getMessages, linkTo } from "../../i18n";
import { formatDate } from "../../i18n/format";
import { DEFAULT_LOCALE, localizePath } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getTranslations, postUrl, readingMinutes } from "../../lib/blog";
import { APP, SITE } from "../../lib/site";
import Band from "../Band.astro";
import Button from "../Button.astro";
import SectionHeader from "../SectionHeader.astro";
import Texture from "../Texture.astro";

const locale = getLocale(Astro);
const t = getMessages(locale);
const translations = (await getTranslations()).get(locale);
const posts = (await getPosts()).map((post) => {
  const translation = translations?.get(post.id);
  const entry = translation ?? post;
  return {
    id: post.id,
    data: entry.data,
    url: postUrl(post.id, translation ? locale : DEFAULT_LOCALE),
    minutes: readingMinutes(entry, translation ? locale : DEFAULT_LOCALE),
    inEnglish: locale !== DEFAULT_LOCALE && !translation,
  };
});
const title = `${t.blog.title} | ${SITE.name}`;
const description = t.blog.description;
const blogUrl = new URL(localizePath("/blog/", locale), SITE.url).href;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: t.site.blogFeedTitle,
    url: blogUrl,
    inLanguage: locale,
    description,
    publisher: { "@type": "Organization", name: SITE.name, url: `${SITE.url}/` },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: new URL(post.url, SITE.url).href,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <Band />
  <section aria-labelledby="blog-title" class="section-y">
    <SectionHeader as="h1" id="blog-title" eyebrow={t.blog.title} title={t.blog.heading} lead={description} />

    <div class="container-page rule-t rule-b mt-14 sm:mt-16">
      {
        posts.length === 0 ? (
          <div class="flex flex-col items-start gap-4 bg-subtle px-5 py-12 sm:px-10 sm:py-14">
            <h2 class="text-title">{t.blog.emptyTitle}</h2>
            <p class="text-links max-w-xl leading-relaxed" set:html={t.blog.emptyText(linkTo(localizePath("/rss.xml", locale)))} />
            <Button href={APP.signUpUrl} class="mt-4">
              {t.cta.startYourFreeTrial}
            </Button>
          </div>
        ) : (
          <ul class="cells-open md:grid-cols-2">
            {posts.map((post, index) => (
              <li class="row-span-3 grid grid-rows-subgrid" data-reveal style={`--reveal-delay: ${(index % 2) * 100}ms`}>
                <article class="group relative row-span-3 grid grid-rows-subgrid">
                  <div class="p-4 sm:p-5">
                    {post.data.image ? (
                      <div class="overflow-hidden border border-line bg-subtle">
                        <Image
                          src={post.data.image}
                          alt={post.data.imageAlt ?? ""}
                          widths={[400, 640, 800, 1200]}
                          sizes="(min-width: 80rem) 38rem, (min-width: 48rem) 45vw, 100vw"
                          class="aspect-[1200/630] w-full object-cover transition-transform duration-500 group-hover:scale-[1.025]"
                        />
                      </div>
                    ) : (
                      <div class="texture aspect-[1200/630]">
                        <Texture name="panel" />
                      </div>
                    )}
                  </div>
                  <div class="flex flex-col gap-3 border-t border-line px-5 py-6 sm:px-6" lang={post.inEnglish ? "en" : undefined}>
                    <h2 class="text-title">
                      <a
                        href={post.url}
                        hreflang={post.inEnglish ? "en" : undefined}
                        class="transition-colors after:absolute after:inset-0 group-hover:text-brand-ink"
                      >
                        {post.data.title}
                      </a>
                    </h2>
                    <p class="leading-relaxed">{post.data.description}</p>
                  </div>
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line bg-subtle px-5 py-4 text-sm text-ink sm:px-6">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, locale)}</time>
                    <span class="text-line-strong" aria-hidden="true">|</span>
                    <span>{t.blog.minutesToRead(post.minutes)}</span>
                    {post.inEnglish && <span class="text-label border border-line bg-page px-2 py-1">{t.blog.inEnglish}</span>}
                    {post.data.draft && <span class="text-label bg-amber-100 px-2 py-1 text-amber-800">{t.blog.draft}</span>}
                    {post.data.tags.slice(0, 1).map((tag) => (
                      <span class="text-label ml-auto border border-brand/50 px-2 py-1 text-brand-ink" lang={post.inEnglish ? "en" : undefined}>
                        {tag}
                      </span>
                    ))}
                  </div>
                </article>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</BaseLayout>
