---
import { getLocale, getMessages } from "../../i18n";
import { LOCALES, localizePath } from "../../i18n/locales";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../Button.astro";

const locale = getLocale(Astro);
const t = getMessages(locale).notFound;
// The language switcher goes to each language's home page.
const homePages = Object.fromEntries(LOCALES.map((option) => [option, localizePath("/", option)]));
---

<BaseLayout title={`${t.title} | Emploist`} description={t.description} noindex alternates={homePages}>
  <section class="container-page flex flex-col items-start py-28 sm:py-40">
    <p class="font-mono text-sm text-faint">404</p>
    <h1 class="text-heading mt-4">{t.heading}</h1>
    <p class="text-lead mt-5 max-w-xl">{t.text}</p>
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={localizePath("/", locale)} size="lg">{t.home}</Button>
      <Button href={localizePath("/blog/", locale)} size="lg" variant="secondary">{t.blog}</Button>
    </div>
  </section>
</BaseLayout>
