---
import Band from "../Band.astro";
import ShareMarkdownActions from "../ShareMarkdownActions.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLocale, getMessages } from "../../i18n";
import { LOCALES, localizePath } from "../../i18n/locales";
import { docsUrl, getGuideMeta, getSupportDocs, resolveGuide } from "../../lib/docs";
import { SITE } from "../../lib/site";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const docs = getSupportDocs(locale);
const guide = resolveGuide(slug, locale);
if (!guide) return Astro.redirect(localizePath("/404/", locale));

const pagePath = docsUrl(slug, locale);
const pageUrl = new URL(pagePath, SITE.url).href;
const title = `${guide.title} | ${t.nav.docs} | ${SITE.name}`;
const alternates = Object.fromEntries(
  LOCALES.filter((lang) => getGuideMeta(slug) && resolveGuide(slug, lang)).map((lang) => [
    lang,
    docsUrl(slug, lang),
  ]),
);
---

<BaseLayout title={title} description={guide.summary} alternates={alternates}>
  <Band />
  <article class="pt-14 sm:pt-20 lg:pt-24">
    <header class="container-page flex flex-col items-center gap-5 px-5 text-center sm:px-8" data-reveal>
      <nav aria-label={t.nav.docs}>
        <a href={localizePath("/docs/", locale)} class="tag transition-colors hover:border-line-strong hover:text-brand-ink">
          {t.nav.docs}
        </a>
      </nav>
      {
        guide.meta.adminOnly && (
          <p class="tag text-faint">{docs.guideList.adminOnly}</p>
        )
      }
      <h1 class="text-heading max-w-3xl" data-reveal="blur" style="--reveal-delay: 80ms">{guide.title}</h1>
      <p class="text-lead max-w-2xl">{guide.summary}</p>
      <ShareMarkdownActions
        markdown={guide.markdown}
        copyLabel={t.docs.copyMarkdown}
        copiedLabel={t.docs.copied}
        discussWith={t.docs.discussWith}
        prompt={t.docs.discussPrompt(guide.title, pageUrl)}
      />
    </header>

    <div class="container-page rule-t rule-b mt-12 sm:mt-16">
      <ol class="divide-y divide-line">
        {
          guide.steps.map((step, index) => (
            <li class="grid gap-4 px-5 py-8 sm:grid-cols-[4rem_minmax(0,1fr)] sm:gap-8 sm:px-8 sm:py-10">
              <p class="text-label tabular-nums text-faint">{String(index + 1).padStart(2, "0")}</p>
              <div class="min-w-0">
                <h2 class="text-[1.125rem] font-semibold tracking-[-0.02em] text-ink">{step.title}</h2>
                <p class="docs-body mt-3 text-[1.0625rem] leading-relaxed text-body" set:html={step.bodyHtml} />
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="container-page px-5 py-10 sm:px-8">
      <a
        href={localizePath("/docs/", locale)}
        class="text-sm font-medium text-brand-ink underline-offset-4 hover:underline"
      >
        ← {t.docs.title}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .docs-body :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .docs-body :global(a) {
    color: var(--brand-ink);
    text-underline-offset: 3px;
  }

  .docs-body :global(a:hover) {
    text-decoration: underline;
  }

  .docs-body :global(code) {
    border-radius: 0.375rem;
    background: var(--subtle);
    padding: 0.1em 0.35em;
    font-size: 0.92em;
    box-shadow: inset 0 0 0 1px var(--line);
  }
</style>
