---
// The directories that list Emploist, with their badges, in the language of
// its address. Only the footer links here.
import { getLocale, getMessages } from "../../i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { DIRECTORIES } from "../../lib/directories";
import { SITE } from "../../lib/site";
import Band from "../Band.astro";
import SectionHeader from "../SectionHeader.astro";

const t = getMessages(getLocale(Astro)).listedOn;
---

<BaseLayout title={`${t.title} | ${SITE.name}`} description={t.description}>
  <Band />
  <section aria-labelledby="listed-title" class="section-y">
    <SectionHeader as="h1" id="listed-title" eyebrow={t.title} title={t.heading} lead={t.lead} />

    <div class="container-page rule-t rule-b mt-14 sm:mt-16">
      <ul class="badges cells-open grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        {
          DIRECTORIES.map((directory) => (
            <li class="flex min-h-32 items-center justify-center p-6">
              {directory.badge ? (
                <Fragment set:html={directory.badge} />
              ) : (
                <a href={directory.url} class="text-[1.125rem] tracking-[-0.03em] text-ink transition-colors hover:text-brand-ink">
                  {directory.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  /* Every badge the same height, whatever size its embed code sets, and no
     wider than its cell. */
  .badges :global(img) {
    width: auto !important;
    max-width: 100% !important;
    height: 54px !important;
    object-fit: contain;
  }
  /* SourceForge's script draws its badges in a box of a set width, with a
     minimum width. Fit the box to the badge. */
  .badges :global(.sf-root) {
    width: auto !important;
  }
  .badges :global(.sf-root img) {
    display: block !important;
    min-width: 0 !important;
  }
</style>
