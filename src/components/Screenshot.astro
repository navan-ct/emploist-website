---
// A screenshot from src/assets/screenshots (made by scripts/screenshots.mjs),
// as AVIF and WebP at several widths.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  /** The file name without `-light.png` or `-dark.png`. */
  name: string;
  alt: string;
  /** The image's displayed width, for the browser to pick a file. */
  sizes: string;
  /** For the largest image above the fold: load it first. */
  priority?: boolean;
  /** Which theme's shot to show: dark on sections that are always dark. */
  scheme?: "light" | "dark";
  class?: string;
}

const { name, alt, sizes, priority = false, scheme = "light", class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/screenshots/*.png", {
  eager: true,
});
const path = `/src/assets/screenshots/${name}-${scheme}.png`;
const src = files[path]?.default;
if (!src) throw new Error(`Missing screenshot: ${path.slice(1)}`);

const WIDTHS = [320, 480, 720, 960, 1280, 1600, 2000, 2560];
const widths = [...WIDTHS.filter((width) => width < src.width), src.width];
const [avif, webp, fallback] = await Promise.all([
  getImage({ src, widths, format: "avif", quality: 64 }),
  getImage({ src, widths, format: "webp", quality: 82 }),
  getImage({ src, width: Math.min(1280, src.width), format: "webp", quality: 82 }),
]);
// Shots are taken at 2x, so their natural size is half their pixels.
const width = Math.round(src.width / 2);
const height = Math.round(src.height / 2);
---

<picture>
  <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
  <source type="image/webp" srcset={webp.srcSet.attribute} sizes={sizes} />
  <img
    src={fallback.src}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? "eager" : "lazy"}
    decoding={priority ? "sync" : "async"}
    fetchpriority={priority ? "high" : "auto"}
    class={className}
  />
</picture>
