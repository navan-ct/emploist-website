---
// A plain window around a screenshot: three squares and, optionally, an
// address.
interface Props {
  url?: string;
  class?: string;
}

const { url, class: className } = Astro.props;
---

<div class:list={["shot", className]}>
  <div class="relative flex h-8 items-center border-b border-line bg-subtle px-3 sm:h-9">
    <div class="flex gap-1.5" aria-hidden="true">
      <span class="size-2 bg-line-strong"></span>
      <span class="size-2 bg-line-strong"></span>
      <span class="size-2 bg-line-strong"></span>
    </div>
    {
      url && (
        <div class="absolute inset-x-0 mx-auto flex h-5 w-fit max-w-[60%] items-center gap-1.5 bg-raised px-2.5 font-mono text-[0.6875rem] text-faint ring-1 ring-line sm:h-6">
          <svg viewBox="0 0 16 16" class="size-3 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="3.5" y="7" width="9" height="6.5" rx="1" />
            <path d="M5.5 7V5.25a2.5 2.5 0 0 1 5 0V7" />
          </svg>
          <span class="truncate">{url}</span>
        </div>
      )
    }
  </div>
  <slot />
</div>
