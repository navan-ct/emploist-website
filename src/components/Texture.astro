---
// A gradient picture from src/assets/textures (drawn by scripts/textures.mjs)
// that fills its .texture box, behind the box's content.
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  name: "hero" | "cta" | "panel" | "panel-alt" | "code";
  /** For the largest picture above the fold: load it first. */
  priority?: boolean;
}

const { name, priority = false } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("/src/assets/textures/*.webp", { eager: true });
const src = files[`/src/assets/textures/${name}.webp`]?.default;
if (!src) throw new Error(`Missing texture: src/assets/textures/${name}.webp`);
// The gradients are smooth, so a small file scaled up looks the same.
const image = await getImage({ src, widths: [640, src.width], format: "webp", quality: 80 });
---

<img
  src={image.src}
  srcset={image.srcSet.attribute}
  sizes="(min-width: 48rem) 80rem, 40rem"
  alt=""
  class="texture-image"
  data-play
  loading={priority ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={priority ? "high" : "auto"}
/>
