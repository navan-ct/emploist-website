---
import { getLocale, getMessages } from "../i18n";
import { LANGUAGE_NAMES, LOCALES, type Locale, localizePath } from "../i18n/locales";
import { APP, NAV } from "../lib/site";
import Button from "./Button.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  /** This page in each language, for the language switcher. */
  alternates: Record<Locale, string>;
}

const { alternates } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const nav = NAV.map((item) => ({ label: t.nav[item.key], href: localizePath(item.href, locale) }));
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-page/85 backdrop-blur-md backdrop-saturate-150">
  <div class="container-page flex h-16 items-center gap-4 sm:gap-8">
    <a href={localizePath("/", locale)} class="-m-1 rounded-md p-1" aria-label={t.site.home}>
      <Wordmark />
    </a>

    <nav aria-label={t.nav.main} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-full px-3 py-1.5 text-[0.9375rem] text-body transition-colors hover:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <div class="max-lg:hidden">
        <LanguageSwitcher alternates={alternates} placement="header" />
      </div>
      <Button href={APP.signInUrl} variant="ghost" class="max-sm:hidden">{t.nav.signIn}</Button>
      <Button href={APP.signUpUrl}>{t.nav.startFreeTrial}</Button>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="-mr-2 inline-flex size-10 items-center justify-center rounded-full text-ink hover:bg-subtle lg:hidden"
        aria-label={t.nav.menu}
      >
        <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M3.5 7h13M3.5 13h13"></path>
        </svg>
      </button>
    </div>
  </div>

  <div
    id="mobile-nav"
    popover
    class="mobile-nav inset-x-0 top-16 m-0 w-full max-w-none border-b border-line bg-page p-0 shadow-lg lg:hidden"
  >
    <nav aria-label={t.nav.main} class="container-page py-4">
      <ul class="flex flex-col">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="block border-b border-line py-3.5 text-lg font-medium text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={APP.signInUrl} class="block border-b border-line py-3.5 text-lg font-medium text-ink">{t.nav.signIn}</a>
        </li>
      </ul>
      <h2 id="mobile-language" class="mt-6 text-sm font-semibold text-faint">{t.language.label}</h2>
      <ul aria-labelledby="mobile-language" class="mt-2 grid grid-cols-2 gap-x-4">
        {
          LOCALES.map((option) => (
            <li>
              <a
                href={alternates[option]}
                hreflang={option}
                lang={option}
                aria-current={option === locale ? "page" : undefined}
                class="block py-2 text-[0.9375rem] text-body aria-[current=page]:font-semibold aria-[current=page]:text-ink"
              >
                {LANGUAGE_NAMES[option]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Jumping to a section from the menu also closes it. Closing moves focus
  // back to the menu button, which would undo the jump, so jump afterwards.
  const nav = document.getElementById("mobile-nav");
  nav?.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest("a") : null;
    if (!link) return;
    nav.hidePopover();
    const url = new URL(link.href);
    const target = url.hash && url.pathname === location.pathname ? document.querySelector(url.hash) : null;
    if (target) {
      event.preventDefault();
      history.pushState(null, "", url.hash);
      target.scrollIntoView();
    }
  });
</script>

<style>
  .mobile-nav:popover-open {
    position: fixed;
  }

  .mobile-nav::backdrop {
    background: oklch(0% 0 0 / 0.2);
  }
</style>
