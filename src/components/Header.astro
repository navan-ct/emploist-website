---
import { getLocale, getMessages } from "../i18n";
import { LANGUAGE_NAMES, LOCALES, type Locale, localizePath } from "../i18n/locales";
import { getFeatures } from "../lib/features";
import { APP, NAV } from "../lib/site";
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import Roll from "./Roll.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  /** This page in each language, for the language switcher. */
  alternates: Record<Locale, string>;
}

const { alternates } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const features = getFeatures(t, locale);
const nav = NAV.map((item) => ({ label: t.nav[item.key], href: localizePath(item.href, locale) }));
---

<header class="rule-b sticky top-0 z-40 bg-page/90 backdrop-blur-md backdrop-saturate-150">
  <div class="container-page flex h-(--header-height) items-center gap-2 pr-2 pl-3 sm:gap-4 sm:px-6 lg:px-8">
    <a href={localizePath("/", locale)} class="-m-1 shrink-0 p-1" aria-label={t.site.home}>
      <Wordmark animated class="max-sm:text-[1.125rem] max-sm:[&_svg]:size-6 max-[22rem]:[&>span]:sr-only" />
    </a>

    <nav aria-label={t.nav.main} class="mx-auto hidden lg:block">
      <ul class="flex items-center xl:gap-3">
        <li>
          <!-- A menu of the landing page's feature sections, like the
               language menu: it opens on a click, or while a mouse rests on
               it (see the script below). -->
          <details class="features-menu group/features relative">
            <summary class="flex h-10 cursor-pointer list-none items-center gap-1.5 px-2.5 text-[0.9375rem] tracking-[-0.02em] text-ink xl:px-3 [&::-webkit-details-marker]:hidden">
              <Roll text={t.nav.features} />
              <svg
                viewBox="0 0 16 16"
                class="size-3 shrink-0 transition-transform group-open/features:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="square"
                aria-hidden="true"
              >
                <path d="m4 6 4 4 4-4"></path>
              </svg>
            </summary>
            <ul class="absolute top-full left-0 z-50 mt-2 w-max min-w-56 border border-line bg-raised shadow-[0_16px_40px_-12px_rgb(13_13_13/0.25)]">
              {
                features.map((feature) => (
                  <li class="border-b border-line last:border-b-0">
                    <a
                      href={feature.href}
                      class="group/item flex items-center gap-3 py-2.5 pr-6 pl-4 text-[0.9375rem] tracking-[-0.02em] whitespace-nowrap text-ink transition-colors hover:bg-subtle"
                    >
                      <Icon path={feature.icon} class="size-[1.125rem] shrink-0 text-body transition-colors group-hover/item:text-ink" stroke={1.4} />
                      {feature.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="px-2.5 py-2 text-[0.9375rem] tracking-[-0.02em] text-ink xl:px-3">
                <Roll text={item.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0 xl:gap-2">
      <div class="max-lg:hidden">
        <LanguageSwitcher alternates={alternates} placement="header" />
      </div>
      <a
        href={APP.signInUrl}
        class="px-2.5 py-2 text-[0.9375rem] tracking-[-0.02em] text-ink max-sm:hidden xl:px-3"
      >
        <Roll text={t.nav.signIn} />
      </a>
      <Button href={APP.signUpUrl} class="max-sm:h-9 max-sm:px-3 max-sm:text-[0.75rem] sm:ml-1 xl:ml-2">{t.nav.startFreeTrial}</Button>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="inline-flex size-9 shrink-0 items-center justify-center text-ink ring-1 ring-line transition-colors ring-inset hover:bg-subtle sm:size-10 lg:hidden"
        aria-label={t.nav.menu}
      >
        <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3.5 7h13M3.5 13h13"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav m-0 border-x-0 border-t-0 border-b border-line bg-page p-0 shadow-xl lg:hidden">
    <nav aria-label={t.nav.main}>
      <ul class="flex flex-col">
        <li>
          <details class="group/features border-b border-line">
            <summary class="flex cursor-pointer list-none items-center justify-between px-5 py-4 text-xl tracking-[-0.035em] text-ink [&::-webkit-details-marker]:hidden">
              {t.nav.features}
              <svg
                viewBox="0 0 16 16"
                class="size-4 text-faint transition-transform duration-500 ease-(--ease-out) group-open/features:rotate-180"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="m3.5 6 4.5 4.5L12.5 6" />
              </svg>
            </summary>
            <ul class="grid grid-cols-2 gap-px border-t border-line bg-line">
              {
                features.map((feature) => (
                  <li class="bg-subtle">
                    <a
                      href={feature.href}
                      class="flex h-full items-center gap-3 px-4 py-3.5 text-[0.9375rem] leading-snug tracking-[-0.02em] text-ink hyphens-auto sm:px-5"
                    >
                      <Icon path={feature.icon} class="size-[1.125rem] shrink-0 text-body" stroke={1.4} />
                      {feature.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>
        </li>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="flex items-center justify-between border-b border-line px-5 py-4 text-xl tracking-[-0.035em] text-ink">
                {item.label}
                <svg viewBox="0 0 16 16" class="size-4 text-faint" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M6 3.5 10.5 8 6 12.5" />
                </svg>
              </a>
            </li>
          ))
        }
        <li>
          <a href={APP.signInUrl} class="flex items-center justify-between border-b border-line px-5 py-4 text-xl tracking-[-0.035em] text-ink">
            {t.nav.signIn}
            <svg viewBox="0 0 16 16" class="size-4 text-faint" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 3.5 10.5 8 6 12.5" />
            </svg>
          </a>
        </li>
      </ul>
      <h2 id="mobile-language" class="text-label border-b border-line bg-subtle px-5 py-3 text-ink">{t.language.label}</h2>
      <ul aria-labelledby="mobile-language" class="grid grid-cols-2 gap-px bg-line">
        {
          LOCALES.map((option) => (
            <li class="bg-page">
              <a
                href={alternates[option]}
                hreflang={option}
                lang={option}
                aria-current={option === locale ? "page" : undefined}
                class="block px-5 py-3 text-[0.9375rem] text-body aria-[current=page]:text-brand-ink"
              >
                {LANGUAGE_NAMES[option]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    // Jumping to a section from the mobile menu also closes it. Closing
    // moves focus back to the menu button, which would undo the jump, so
    // jump afterwards.
    const nav = document.getElementById("mobile-nav");
    nav?.addEventListener("click", (event) => {
      const link = event.target instanceof Element ? event.target.closest("a") : null;
      if (!link) return;
      nav.hidePopover();
      const url = new URL(link.href);
      const target = url.hash && url.pathname === location.pathname ? document.querySelector(url.hash) : null;
      if (target) {
        event.preventDefault();
        history.pushState(null, "", url.hash);
        target.scrollIntoView();
      }
    });

    // The Features menu opens on a click, or when a mouse rests on it, and
    // closes when the mouse leaves it, on a click outside it, on Escape, or
    // once a section is picked. A click while it's open from hovering keeps
    // it open, rather than closing it under the pointer.
    const menu = document.querySelector("details.features-menu");
    const summary = menu?.querySelector("summary");
    if (!menu || !summary) return;
    let openTimer;
    let closeTimer;
    let hovered = false;
    menu.addEventListener("pointerenter", (event) => {
      if (event.pointerType !== "mouse") return;
      clearTimeout(closeTimer);
      if (menu.open) return;
      openTimer = setTimeout(() => {
        menu.open = true;
        hovered = true;
      }, 80);
    });
    menu.addEventListener("pointerleave", (event) => {
      if (event.pointerType !== "mouse") return;
      clearTimeout(openTimer);
      if (hovered) closeTimer = setTimeout(() => (menu.open = false), 200);
    });
    summary.addEventListener("click", (event) => {
      clearTimeout(openTimer);
      if (hovered && menu.open) {
        event.preventDefault();
        hovered = false;
      }
    });
    menu.addEventListener("toggle", () => {
      if (!menu.open) hovered = false;
    });
    menu.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) menu.open = false;
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !(event.target instanceof Node && menu.contains(event.target))) menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      summary.focus();
    });
  })();
</script>

<style>
  /* Opens below the header, between the rails. */
  .mobile-nav:popover-open {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(var(--content-max), 100% - 2 * var(--inset));
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }

  .mobile-nav::backdrop {
    background: rgb(13 13 13 / 0.18);
  }
</style>
