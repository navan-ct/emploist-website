---
import { getLocale, getMessages } from "../i18n";
import { LANGUAGE_NAMES, LOCALES, type Locale, localizePath } from "../i18n/locales";
import { APP, NAV } from "../lib/site";
import Button from "./Button.astro";
import Roll from "./Roll.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import Wordmark from "./Wordmark.astro";

interface Props {
  /** This page in each language, for the language switcher. */
  alternates: Record<Locale, string>;
}

const { alternates } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
const nav = NAV.map((item) => ({ label: t.nav[item.key], href: localizePath(item.href, locale) }));
---

<header class="rule-b sticky top-0 z-40 bg-page/90 backdrop-blur-md backdrop-saturate-150">
  <div class="container-page flex h-(--header-height) items-center gap-2 pr-2 pl-3 sm:gap-4 sm:px-6 lg:px-8">
    <a href={localizePath("/", locale)} class="-m-1 shrink-0 p-1" aria-label={t.site.home}>
      <Wordmark class="max-sm:text-[1.125rem] max-sm:[&_svg]:size-6 max-[22rem]:[&>span]:sr-only" />
    </a>

    <nav aria-label={t.nav.main} class="mx-auto hidden lg:block">
      <ul class="flex items-center xl:gap-3">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="px-2.5 py-2 text-[0.9375rem] tracking-[-0.02em] text-ink xl:px-3">
                <Roll text={item.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1 lg:ml-0 xl:gap-2">
      <div class="max-lg:hidden">
        <LanguageSwitcher alternates={alternates} placement="header" />
      </div>
      <a
        href={APP.signInUrl}
        class="px-2.5 py-2 text-[0.9375rem] tracking-[-0.02em] text-ink max-sm:hidden xl:px-3"
      >
        <Roll text={t.nav.signIn} />
      </a>
      <Button href={APP.signUpUrl} class="max-sm:h-9 max-sm:px-3 max-sm:text-[0.75rem] sm:ml-1 xl:ml-2">{t.nav.startFreeTrial}</Button>
      <button
        type="button"
        popovertarget="mobile-nav"
        class="inline-flex size-9 shrink-0 items-center justify-center text-ink ring-1 ring-line transition-colors ring-inset hover:bg-subtle sm:size-10 lg:hidden"
        aria-label={t.nav.menu}
      >
        <svg viewBox="0 0 20 20" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M3.5 7h13M3.5 13h13"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" popover class="mobile-nav m-0 border-x-0 border-t-0 border-b border-line bg-page p-0 shadow-xl lg:hidden">
    <nav aria-label={t.nav.main}>
      <ul class="flex flex-col">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="flex items-center justify-between border-b border-line px-5 py-4 text-xl tracking-[-0.035em] text-ink">
                {item.label}
                <svg viewBox="0 0 16 16" class="size-4 text-faint" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M6 3.5 10.5 8 6 12.5" />
                </svg>
              </a>
            </li>
          ))
        }
        <li>
          <a href={APP.signInUrl} class="flex items-center justify-between border-b border-line px-5 py-4 text-xl tracking-[-0.035em] text-ink">
            {t.nav.signIn}
            <svg viewBox="0 0 16 16" class="size-4 text-faint" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M6 3.5 10.5 8 6 12.5" />
            </svg>
          </a>
        </li>
      </ul>
      <h2 id="mobile-language" class="text-label border-b border-line bg-subtle px-5 py-3 text-ink">{t.language.label}</h2>
      <ul aria-labelledby="mobile-language" class="grid grid-cols-2 gap-px bg-line">
        {
          LOCALES.map((option) => (
            <li class="bg-page">
              <a
                href={alternates[option]}
                hreflang={option}
                lang={option}
                aria-current={option === locale ? "page" : undefined}
                class="block px-5 py-3 text-[0.9375rem] text-body aria-[current=page]:text-brand-ink"
              >
                {LANGUAGE_NAMES[option]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  // Jumping to a section from the menu also closes it. Closing moves focus
  // back to the menu button, which would undo the jump, so jump afterwards.
  const nav = document.getElementById("mobile-nav");
  nav?.addEventListener("click", (event) => {
    const link = event.target instanceof Element ? event.target.closest("a") : null;
    if (!link) return;
    nav.hidePopover();
    const url = new URL(link.href);
    const target = url.hash && url.pathname === location.pathname ? document.querySelector(url.hash) : null;
    if (target) {
      event.preventDefault();
      history.pushState(null, "", url.hash);
      target.scrollIntoView();
    }
  });
</script>

<style>
  /* Opens below the header, between the rails. */
  .mobile-nav:popover-open {
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(var(--content-max), 100% - 2 * var(--inset));
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }

  .mobile-nav::backdrop {
    background: rgb(13 13 13 / 0.18);
  }
</style>
