---

<div class="share-actions" data-share-actions>
  <div class="share-discuss">
    <p class="share-discuss-label">{discussWith}</p>
    <ul class="share-discuss-row" role="list">
      {
        links.map((link) => (
          <li class={link.id}>
            <a href={link.href} target="_blank" rel="noopener noreferrer" class="share-ai">
              <svg width="16" height="17" viewBox="0 0 16 17" fill="currentColor" aria-hidden="true" set:html={link.svg} />
              <span>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <button
    type="button"
    class="share-copy"
    data-copy-markdown
    data-label={copyLabel}
    data-copied={copiedLabel}
  >
    <svg viewBox="0 0 20 20" width="15" height="15" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4">
      <rect x="7" y="7" width="9" height="10" rx="1.5"></rect>
      <path d="M13 7V4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v9A1.5 1.5 0 0 0 4.5 15H7"></path>
    </svg>
    <span data-copy-text>{copyLabel}</span>
  </button>

  <textarea class="sr-only" aria-hidden="true" readonly data-markdown-source tabindex="-1">{markdown}</textarea>
</div>

<style>
  .share-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    max-width: 42rem;
  }

  .share-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.25rem;
    padding-inline: 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--raised);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms;
  }

  .share-copy:hover {
    border-color: var(--line-strong);
    background: var(--subtle);
  }

  .share-discuss {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem 0.65rem;
    width: 100%;
  }

  .share-discuss-label {
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .share-discuss-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .share-ai {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding-inline: 0.65rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: color-mix(in srgb, var(--raised) 88%, var(--subtle));
    color: color-mix(in srgb, var(--ink) 78%, var(--body));
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    text-decoration: none;
    transition:
      background-color 150ms,
      border-color 150ms,
      color 150ms;
  }

  .share-ai:hover {
    border-color: var(--line-strong);
    background: var(--subtle);
    color: var(--ink);
  }

  .share-ai svg {
    flex-shrink: 0;
  }
</style>

<script>
  function bindCopy(root: Element) {
    const button = root.querySelector<HTMLButtonElement>("[data-copy-markdown]");
    const source = root.querySelector<HTMLTextAreaElement>("[data-markdown-source]");
    const text = button?.querySelector("[data-copy-text]");
    if (!button || !source || !text || button.dataset.bound === "1") return;
    button.dataset.bound = "1";

    const label = button.dataset.label ?? "Copy markdown";
    const copied = button.dataset.copied ?? "Copied";

    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(source.value);
      text.textContent = copied;
      window.setTimeout(() => {
        text.textContent = label;
      }, 1600);
    });
  }

  const scan = () => document.querySelectorAll("[data-share-actions]").forEach(bindCopy);
  scan();
  document.addEventListener("astro:page-load", scan);
</script>
