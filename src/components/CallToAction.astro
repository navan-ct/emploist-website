---
import { getLocale, getMessages, PLAN_FACTS } from "../i18n";
import { APP, SITE } from "../lib/site";

const messages = getMessages(getLocale(Astro));
const t = messages.callToAction;
---

<section aria-labelledby="cta-title" class="container-page pb-20 sm:pb-28">
  <div class="grid items-center gap-12 overflow-hidden rounded-3xl bg-brand px-8 py-14 sm:px-14 sm:py-16 lg:grid-cols-12">
    <div class="lg:col-span-7">
      <h2 id="cta-title" class="text-heading text-white">{t.title}</h2>
      <p class="text-lead mt-5 max-w-xl text-indigo-100">{t.text(PLAN_FACTS)}</p>
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href={APP.signUpUrl}
          class="inline-flex h-12 items-center rounded-full bg-white px-6 font-medium text-brand-hover shadow-sm transition-colors hover:bg-brand-soft"
        >
          {messages.cta.startYourFreeTrial}
        </a>
        <a
          href={`mailto:${SITE.supportEmail}`}
          class="inline-flex h-12 items-center rounded-full px-6 font-medium text-white ring-1 ring-white/35 transition-colors ring-inset hover:bg-white/10"
        >
          {t.talkToUs}
        </a>
      </div>
    </div>

    <!-- The mark's ranked bars, drawn large: the best first. -->
    <svg
      viewBox="0 0 320 196"
      class="hidden w-full max-w-sm justify-self-end text-white lg:col-span-5 lg:block"
      aria-hidden="true"
    >
      <rect x="0" y="0" width="320" height="52" rx="26" fill="currentColor"></rect>
      <rect x="0" y="72" width="226" height="52" rx="26" fill="currentColor" opacity="0.7"></rect>
      <rect x="0" y="144" width="132" height="52" rx="26" fill="currentColor" opacity="0.42"></rect>
    </svg>
  </div>
</section>
