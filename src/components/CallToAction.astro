---
import { getLocale, getMessages, PLAN_FACTS } from "../i18n";
import { APP, SITE } from "../lib/site";
import Button from "./Button.astro";
import Texture from "./Texture.astro";

const messages = getMessages(getLocale(Astro));
const t = messages.callToAction;
---

<section aria-labelledby="cta-title" class="section-y">
  <div class="container-page rule-t rule-b">
    <div class="texture scheme-dark flex min-h-[32rem] flex-col items-center justify-center px-5 py-20 text-center sm:min-h-[36rem]">
      <Texture name="cta" />
      <div class="flex max-w-2xl flex-col items-center gap-6" data-reveal>
        <h2 id="cta-title" class="text-heading max-w-[16em]" data-reveal="blur" style="--reveal-delay: 100ms">{t.title}</h2>
        <p class="text-lead max-w-xl">{t.text(PLAN_FACTS)}</p>
        <div class="mt-3 flex flex-wrap items-center justify-center gap-3">
          <Button href={APP.signUpUrl} size="lg" variant="light">{messages.cta.startYourFreeTrial}</Button>
          <Button href={`mailto:${SITE.supportEmail}`} size="lg" variant="outline-light">{t.talkToUs}</Button>
        </div>
      </div>
    </div>
  </div>
</section>
