---
// A menu of the page in each language, in that language's own words. Opens
// downward in the header and upward in the footer. Links go to the same page
// in the other language, or its nearest page when there's no translation.
import { getLocale, getMessages } from "../i18n";
import { LANGUAGE_NAMES, LOCALES, type Locale } from "../i18n/locales";

interface Props {
  /** The page's address in each language. */
  alternates: Record<Locale, string>;
  placement: "header" | "footer";
}

const { alternates, placement } = Astro.props;
const locale = getLocale(Astro);
const t = getMessages(locale);
---

<details class="language-switcher group/lang relative">
  <summary
    class:list={[
      "flex cursor-pointer list-none items-center gap-1.5 transition-colors hover:text-brand-ink [&::-webkit-details-marker]:hidden",
      placement === "header" ? "h-10 px-2 font-mono xl:px-3 text-[0.8125rem] text-ink" : "-mx-1 px-1 py-0.5 text-sm text-ink",
    ]}
    aria-label={`${t.language.label}: ${LANGUAGE_NAMES[locale]}`}
  >
    <svg viewBox="0 0 20 20" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
      <circle cx="10" cy="10" r="7.25"></circle>
      <path d="M2.75 10h14.5M10 2.75c2 2 3 4.4 3 7.25s-1 5.25-3 7.25c-2-2-3-4.4-3-7.25s1-5.25 3-7.25Z"></path>
    </svg>
    <span aria-hidden="true">{placement === "header" ? locale.toUpperCase() : LANGUAGE_NAMES[locale]}</span>
    <svg
      viewBox="0 0 16 16"
      class="size-3 shrink-0 transition-transform group-open/lang:rotate-180"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="square"
      aria-hidden="true"
    >
      <path d={placement === "header" ? "m4 6 4 4 4-4" : "m4 10 4-4 4 4"}></path>
    </svg>
  </summary>
  <ul
    class:list={[
      "absolute z-50 w-52 border border-line bg-raised shadow-[0_16px_40px_-12px_rgb(13_13_13/0.25)]",
      placement === "header" ? "top-full right-0 mt-2" : "bottom-full mb-3 max-sm:left-0 sm:right-0",
    ]}
  >
    {
      LOCALES.map((option) => (
        <li class="border-b border-line last:border-b-0">
          <a
            href={alternates[option]}
            hreflang={option}
            lang={option}
            aria-current={option === locale ? "page" : undefined}
            class="flex items-center justify-between gap-3 px-4 py-2.5 text-[0.9375rem] tracking-[-0.02em] text-ink transition-colors hover:bg-subtle aria-[current=page]:text-brand-ink"
          >
            {LANGUAGE_NAMES[option]}
            {option === locale && <span class="size-1.5 bg-brand" aria-hidden="true" />}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<script is:inline>
  // Close an open language menu on a click outside it, or on Escape.
  if (!window.languageSwitcherReady) {
    window.languageSwitcherReady = true;
    const openMenus = () => document.querySelectorAll("details.language-switcher[open]");
    document.addEventListener("click", (event) => {
      for (const menu of openMenus()) {
        if (!(event.target instanceof Node && menu.contains(event.target))) menu.open = false;
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      for (const menu of openMenus()) {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
