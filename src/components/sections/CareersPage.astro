---
import { getLocale, getMessages } from "../../i18n";
import { CAREERS_FACT_ICONS } from "../../lib/icons";
import Icon from "../Icon.astro";
import Screenshot from "../Screenshot.astro";
import SectionHeader from "../SectionHeader.astro";
import Window from "../Window.astro";

const t = getMessages(getLocale(Astro)).careersPage;
---

<section id="careers-page" aria-labelledby="careers-title" class="section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="careers-title" lead={t.lead} />

  <div class="container-page rule-t rule-b mt-14 sm:mt-16">
    <!-- The careers page on a wide screen, and a job on a phone. -->
    <div class="grid-stage overflow-hidden bg-subtle px-4 pt-6 pb-6 sm:aspect-[2/1] sm:px-10 sm:pt-12 sm:pb-0 lg:px-16 lg:pt-16" style="--grid-size: 48px">
      <div class="relative mx-auto max-w-5xl lg:pr-24" data-reveal style="--reveal-delay: 120ms">
        <Window url="fieldnote.emploist.com">
          <Screenshot name="careers-page" alt={t.screenshotAlt} sizes="(min-width: 64rem) 58rem, calc(100vw - 2.5rem)" />
        </Window>
        <div
          class="float-card absolute right-0 -bottom-16 hidden w-48 sm:block lg:-bottom-28 rounded-[2rem] border-[6px] border-[#141414] bg-[#141414] shadow-[0_24px_48px_-16px_rgb(13_13_13/0.45)] lg:w-60"
        >
          <div class="overflow-hidden rounded-[1.625rem] bg-white">
            <Screenshot name="careers-job-mobile" alt={t.mobileScreenshotAlt} sizes="15rem" />
          </div>
        </div>
      </div>
    </div>

    <dl class="cells sm:grid-cols-2 lg:grid-cols-3" data-stagger style="--stagger-step: 80ms">
      {
        t.facts.map((fact, index) => (
          <div class="row-span-2 grid grid-rows-subgrid">
            <dt class="rule-t flex items-center gap-3 bg-subtle px-5 py-4 sm:px-6">
              <Icon
                path={CAREERS_FACT_ICONS[index] ?? CAREERS_FACT_ICONS[0]}
                class="size-5 shrink-0 text-brand-ink"
                stroke={1.4}
              />
              <span class="text-[1.25rem] leading-snug tracking-[-0.04em] text-ink">{fact.title}</span>
            </dt>
            <dd class="rule-t px-5 pt-5 pb-7 leading-relaxed sm:px-6">{fact.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

