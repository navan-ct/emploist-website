---
import { getLocale, getMessages } from "../../i18n";
import Screenshot from "../Screenshot.astro";
import Window from "../Window.astro";

const t = getMessages(getLocale(Astro)).careersPage;
---

<section
  id="careers-page"
  aria-labelledby="careers-title"
  class="overflow-hidden border-y border-line bg-subtle py-20 sm:py-28"
>
  <div class="container-page">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-eyebrow">{t.eyebrow}</p>
      <h2 id="careers-title" class="text-heading mt-4">{t.title}</h2>
      <p class="text-lead mx-auto mt-6 max-w-2xl">{t.lead}</p>
    </div>

    <div class="relative mx-auto mt-14 max-w-5xl pb-6 sm:mt-16 lg:pr-20">
      <Window url="northwind.emploist.com">
        <Screenshot
          name="careers-page"
          alt={t.screenshotAlt}
          sizes="(min-width: 64rem) 58rem, calc(100vw - 2.5rem)"
        />
      </Window>
      <div
        class="absolute right-0 -bottom-4 hidden w-56 rounded-[2.25rem] border-[7px] border-zinc-900 bg-zinc-900 shadow-2xl ring-1 ring-black/10 sm:block lg:w-64"
      >
        <div class="overflow-hidden rounded-[1.75rem] bg-white">
          <Screenshot
            name="careers-job-mobile"
            alt={t.mobileScreenshotAlt}
            sizes="16rem"
          />
        </div>
      </div>
    </div>

    <dl class="mt-20 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.facts.map((fact) => (
          <div class="border-t border-line-strong pt-5">
            <dt class="font-semibold text-ink">{fact.title}</dt>
            <dd class="mt-2 text-[0.9375rem] leading-relaxed">{fact.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
