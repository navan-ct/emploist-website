---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import { APP } from "../../lib/site";
import Button from "../Button.astro";
import Screenshot from "../Screenshot.astro";
import Window from "../Window.astro";

const messages = getMessages(getLocale(Astro));
const t = messages.hero;
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <div class="container-page pt-16 sm:pt-24 lg:pt-28">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
      <div class="lg:col-span-7">
        <p class="text-eyebrow flex items-center gap-2">
          <svg viewBox="0 0 16 16" class="size-4" aria-hidden="true">
            <rect x="1" y="2.5" width="14" height="2.6" rx="1.3" fill="currentColor"></rect>
            <rect x="1" y="6.7" width="10" height="2.6" rx="1.3" fill="currentColor" opacity="0.7"></rect>
            <rect x="1" y="10.9" width="6" height="2.6" rx="1.3" fill="currentColor" opacity="0.45"></rect>
          </svg>
          {t.eyebrow}
        </p>
        <h1 id="hero-title" class="text-display mt-5">{t.title}</h1>
      </div>
      <div class="lg:col-span-5 lg:pb-2">
        <p class="text-lead">{t.lead}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <Button href={APP.signUpUrl} size="lg">{messages.cta.startYourFreeTrial}</Button>
          <Button href="#how-it-works" size="lg" variant="secondary">{t.seeHowItWorks}</Button>
        </div>
        <p class="mt-5 text-sm text-faint">{t.note(PLAN_FACTS)}</p>
      </div>
    </div>
  </div>

  <!-- The product, on a tinted stage that starts halfway down the window. -->
  <div class="relative mt-14 sm:mt-20">
    <div
      class="absolute inset-x-0 top-[38%] bottom-0 -z-10 border-t border-line bg-subtle"
      aria-hidden="true"
    >
    </div>
    <div class="container-page pb-16 sm:pb-24">
      <Window url="app.emploist.com" class="hero-shot mx-auto">
        <Screenshot
          name="applications"
          alt={t.screenshotAlt}
          sizes="(min-width: 76rem) 72rem, (min-width: 40rem) calc(100vw - 4rem), 175vw"
          priority
        />
      </Window>
    </div>
  </div>
</section>

<style>
  /* On phones the whole window is too small to read, so zoom in on the
     ranked list and leave the sidebar out of view. */
  @media (width < 40rem) {
    :global(.hero-shot img) {
      width: 175%;
      max-width: none;
      margin-left: -41%;
    }
  }
</style>
