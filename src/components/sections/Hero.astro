---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import { APP } from "../../lib/site";
import Button from "../Button.astro";
import Screenshot from "../Screenshot.astro";
import SectionHeader from "../SectionHeader.astro";
import Texture from "../Texture.astro";
import Window from "../Window.astro";

const messages = getMessages(getLocale(Astro));
const t = messages.hero;
---

<section aria-labelledby="hero-title">
  <div class="pt-16 pb-14 sm:pt-24 sm:pb-20 lg:pt-28">
    <SectionHeader as="h1" id="hero-title" eyebrow={t.eyebrow} title={t.title} lead={t.lead}>
      <div class="mt-3 flex w-full flex-col items-stretch justify-center gap-3 sm:mt-4 sm:w-auto sm:flex-row sm:items-center" data-reveal style="--reveal-delay: 160ms">
        <Button href={APP.signUpUrl} size="lg">{t.cta}</Button>
        <Button href="#how-it-works" size="lg" variant="secondary">{t.seeHowItWorks}</Button>
      </div>
      <p class="text-sm text-faint" data-reveal style="--reveal-delay: 240ms">
        <span class="mr-2 inline-block size-1.5 rounded-full bg-emerald-500 align-middle shadow-[0_0_0_3px_rgb(16_185_129/0.15)]" aria-hidden="true"></span>{t.note(PLAN_FACTS)}
      </p>
    </SectionHeader>
  </div>

  <!-- The product, on a gradient stage that crops it at the bottom. -->
  <div class="container-page rule-t">
    <div class="texture hero-stage" data-reveal style="--reveal-delay: 200ms">
      <Texture name="hero" priority />
      <div class="hero-rise px-3 pt-6 sm:px-10 sm:pt-12 lg:px-16 lg:pt-16">
        <Window url="app.emploist.com" class="hero-shot">
          <Screenshot
            name="applications"
            alt={t.screenshotAlt}
            sizes="(min-width: 80rem) 72rem, (min-width: 40rem) calc(100vw - 9rem), 175vw"
            priority
          />
        </Window>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-stage {
    height: min(46rem, 62vw);
  }

  /* On phones the whole window is too small to read, so zoom in on the
     ranked list and leave the sidebar out of view. */
  @media (width < 40rem) {
    .hero-stage {
      height: 26rem;
    }

    :global(.hero-shot img) {
      width: 175%;
      max-width: none;
      margin-left: -41%;
    }
  }
</style>
