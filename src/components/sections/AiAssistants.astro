---
// Connecting AI assistants through the app's MCP server. The chat is drawn in
// HTML, with the same applicants and matches as the hero's screenshot.
import { getLocale, getMessages } from "../../i18n";
import { ASSISTANTS } from "../../lib/assistants";
import SectionHeader from "../SectionHeader.astro";

const t = getMessages(getLocale(Astro)).aiAssistants;

const matches = [
  { name: "Diego Varga", initials: "DV", match: 91 },
  { name: "Kofi Clarke", initials: "KC", match: 88 },
  { name: "Fatima Lindqvist", initials: "FL", match: 86 },
];

// Line icons on a 20 × 20 grid, like the "And more" section's.
const plugIcon = "M7.25 2.75v3.5M12.75 2.75v3.5M5.25 6.25h9.5v2.25a4.75 4.75 0 0 1-9.5 0V6.25ZM10 13.25v4";
const checkIcon = "m5.5 10.25 3 3 6-6.5";
---

<section id="ai-assistants" aria-labelledby="assistants-title" class="section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="assistants-title" lead={t.lead} />

  <div class="container-page rule-t rule-b mt-14 sm:mt-16">
    <div class="cells lg:grid-cols-12">
      <!-- The points come first, so the chat beside them covers their
           hairlines as they run across. -->
      <ul class="flex flex-col lg:col-span-5" data-stagger style="--stagger-start: 150ms; --stagger-step: 90ms">
        {
          t.points.map((point, index) => (
            <li class:list={["pad-x flex flex-1 flex-col justify-center gap-2.5 py-7 sm:py-8", index > 0 && "rule-t"]}>
              <h3 class="text-title">{point.title.replace(/[.。．]$/, "")}</h3>
              <p class="leading-relaxed">{point.text}</p>
            </li>
          ))
        }
      </ul>

      <figure class="assistants-stage relative min-w-0 bg-subtle p-3 max-lg:rule-t sm:p-8 lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <div class="shot" role="group" aria-label={t.chat.label} data-reveal>
          <div class="flex h-12 items-center justify-between gap-3 border-b border-line px-4">
            <div class="flex min-w-0 items-center gap-2.5 text-sm whitespace-nowrap text-ink">
              <span class="flex size-7 shrink-0 items-center justify-center bg-brand text-white" aria-hidden="true">
                <svg viewBox="0 0 20 20" class="size-4" fill="currentColor">
                  <path d="M10 2.5c.45 3.6 1.9 5.05 5.5 5.5-3.6.45-5.05 1.9-5.5 5.5-.45-3.6-1.9-5.05-5.5-5.5 3.6-.45 5.05-1.9 5.5-5.5Z"></path>
                  <path d="M15.25 12.5c.2 1.55.7 2.05 2.25 2.25-1.55.2-2.05.7-2.25 2.25-.2-1.55-.7-2.05-2.25-2.25 1.55-.2 2.05-.7 2.25-2.25Z" opacity="0.6"></path>
                </svg>
              </span>
              <span class="truncate">{t.chat.assistant}</span>
            </div>
            <span class="text-label inline-flex items-center gap-1.5 bg-subtle px-2.5 py-1.5 whitespace-nowrap text-ink ring-1 ring-line">
              <span class="size-1.5 bg-emerald-500" aria-hidden="true"></span>
              Emploist<span class="max-sm:sr-only"> {t.chat.connected}</span>
            </span>
          </div>

          <div class="chat flex flex-col gap-4 p-4 text-[0.9375rem] leading-relaxed sm:p-6" data-stagger style="--stagger-start: 300ms; --stagger-step: 380ms">
            <p class="max-w-[85%] self-end bg-brand px-4 py-2.5 text-on-brand">
              {t.chat.question}
            </p>
            <p class="tool-chip flex w-fit items-center gap-2 border border-line bg-subtle px-2.5 py-1.5 text-xs">
              <svg viewBox="0 0 20 20" class="size-3.5 text-brand-ink" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={plugIcon}></path>
              </svg>
              <span class="sr-only">{t.chat.used}</span>
              <span class="text-ink">Emploist</span>
              <span class="font-mono text-faint">list_applications</span>
              <span class="tool-status relative size-3.5" aria-hidden="true">
                <span class="tool-spinner absolute inset-0 rounded-full border-[1.5px] border-line-strong border-t-brand"></span>
                <svg viewBox="0 0 20 20" class="tool-check absolute inset-0 size-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={checkIcon}></path>
                </svg>
              </span>
            </p>
            <p class="text-ink">{t.chat.answerIntro}</p>
            <ol class="divide-y divide-line border border-line">
              {
                matches.map((applicant) => (
                  <li class="flex items-center gap-3 px-3.5 py-2.5">
                    <span
                      class="flex size-8 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-xs font-medium text-emerald-700"
                      aria-hidden="true"
                    >
                      {applicant.initials}
                    </span>
                    <span class="truncate text-sm text-ink">{applicant.name}</span>
                    <span class="ml-auto shrink-0 bg-emerald-50 px-2 py-0.5 font-mono text-xs text-emerald-700 tabular-nums">
                      <span data-count={applicant.match} data-format="percent" data-count-delay="1500">{t.chat.match(applicant.match).value}</span>
                      <span class="max-sm:sr-only"> {t.chat.match(applicant.match).label}</span>
                    </span>
                  </li>
                ))
              }
            </ol>
            <p>{t.chat.answerOutro}</p>
            <p class="max-w-[85%] self-end bg-brand px-4 py-2.5 text-on-brand">
              {t.chat.request}
            </p>
            <p class="tool-chip flex w-fit items-center gap-2 border border-line bg-subtle px-2.5 py-1.5 text-xs">
              <svg viewBox="0 0 20 20" class="size-3.5 text-brand-ink" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={plugIcon}></path>
              </svg>
              <span class="sr-only">{t.chat.used}</span>
              <span class="text-ink">Emploist</span>
              <span class="font-mono text-faint">move_application</span>
              <span class="tool-status relative size-3.5" aria-hidden="true">
                <span class="tool-spinner absolute inset-0 rounded-full border-[1.5px] border-line-strong border-t-brand"></span>
                <svg viewBox="0 0 20 20" class="tool-check absolute inset-0 size-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={checkIcon}></path>
                </svg>
              </span>
            </p>
            <p>{t.chat.done}</p>
          </div>

          <div class="border-t border-line p-3 sm:p-4" aria-hidden="true">
            <div class="flex h-11 items-center justify-between gap-3 bg-subtle pr-1.5 pl-4 text-sm text-faint ring-1 ring-line">
              <span class="truncate">{t.chat.placeholder}</span>
              <span class="flex size-8 shrink-0 items-center justify-center bg-brand text-on-brand">
                <svg viewBox="0 0 20 20" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
                  <path d="M10 15.5v-11m0 0L5.5 9M10 4.5 14.5 9"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
        <figcaption class="mt-4 px-1 text-sm text-faint sm:mt-6 sm:px-0">{t.caption}</figcaption>
      </figure>
    </div>

    <!-- The assistants it works with, like a row of logos. -->
    <div class="cells grid-cols-2 sm:grid-cols-3 lg:grid-cols-6" data-stagger style="--stagger-step: 60ms">
      <div class="rule-t flex flex-col justify-center gap-1 bg-subtle px-5 py-6 sm:px-6">
        <p class="text-label text-ink">{t.worksWith}</p>
        <p class="text-sm text-faint">{t.otherClients}</p>
      </div>
      {
        ASSISTANTS.map((assistant) => (
          <p class="rule-t flex min-h-24 items-center justify-center gap-2.5 px-3 text-ink/65">
            <svg viewBox="0 0 24 24" class="size-5 shrink-0 sm:size-6" fill="currentColor" aria-hidden="true">
              <path d={assistant.path} />
            </svg>
            <span class="text-[1.0625rem] font-medium tracking-[-0.04em] whitespace-nowrap sm:text-[1.1875rem]">{assistant.name}</span>
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Each tool runs for a moment, then shows it's done. */
  .tool-check {
    opacity: 1;
  }

  .tool-spinner {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .chat .tool-spinner {
      opacity: 1;
      animation: chat-spin 0.7s linear infinite;
    }

    :global(.js) .chat .tool-check {
      opacity: 0;
      transform: scale(0.4);
    }

    :global(.js) .chat:global(.is-revealed) .tool-spinner {
      animation:
        chat-spin 0.7s linear infinite,
        chat-hide 0.2s calc(var(--stagger-start) + var(--i) * var(--stagger-step) + 0.9s) forwards;
    }

    :global(.js) .chat:global(.is-revealed) .tool-check {
      animation: chat-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--stagger-start) + var(--i) * var(--stagger-step) + 1s) forwards;
    }

    @keyframes chat-spin {
      to {
        rotate: 360deg;
      }
    }

    @keyframes chat-hide {
      to {
        opacity: 0;
      }
    }

    @keyframes chat-pop {
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* Hairlines in a fine grid behind the chat. */
  .assistants-stage {
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
  }
</style>
