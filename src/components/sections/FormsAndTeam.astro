---
import { getLocale, getMessages } from "../../i18n";
import Screenshot from "../Screenshot.astro";

const t = getMessages(getLocale(Astro)).formsAndTeam;
---

<section aria-label={t.label} class="py-20 sm:py-28">
  <div class="container-page grid gap-6 lg:grid-cols-12">
    <article
      aria-labelledby="forms-title"
      class="flex flex-col overflow-hidden rounded-3xl border border-line bg-subtle lg:col-span-7"
    >
      <div class="p-8 sm:p-10">
        <p class="text-eyebrow">{t.forms.eyebrow}</p>
        <h2 id="forms-title" class="text-subheading mt-3">{t.forms.title}</h2>
        <p class="mt-3 max-w-lg leading-relaxed">{t.forms.text}</p>
      </div>
      <div class="mt-auto pl-8 sm:pl-10">
        <div class="shot max-h-[23rem] rounded-r-none rounded-b-none border-r-0 border-b-0">
          <Screenshot
            name="form"
            alt={t.forms.screenshotAlt}
            sizes="(min-width: 76rem) 40rem, (min-width: 64rem) 52vw, calc(100vw - 4.5rem)"
          />
        </div>
      </div>
    </article>

    <article
      aria-labelledby="team-title"
      class="flex flex-col overflow-hidden rounded-3xl border border-line bg-subtle lg:col-span-5"
    >
      <div class="p-8 sm:p-10">
        <p class="text-eyebrow">{t.team.eyebrow}</p>
        <h2 id="team-title" class="text-subheading mt-3">{t.team.title}</h2>
        <p class="mt-3 max-w-md leading-relaxed">{t.team.text}</p>
      </div>
      <div class="mt-auto pl-8 sm:pl-10">
        <!-- Anchored to the bottom, where the new comment and its mention are. -->
        <div class="shot flex h-[23rem] flex-col justify-end rounded-r-none rounded-b-none border-r-0 border-b-0">
          <Screenshot
            name="comments"
            alt={t.team.screenshotAlt}
            sizes="(min-width: 76rem) 26rem, (min-width: 64rem) 36vw, calc(100vw - 4.5rem)"
          />
        </div>
      </div>
    </article>
  </div>
</section>
