---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import { formatPercent } from "../../i18n/format";
import MatchRing from "../MatchRing.astro";
import Screenshot from "../Screenshot.astro";
import SectionHeader from "../SectionHeader.astro";
import Texture from "../Texture.astro";

const locale = getLocale(Astro);
const messages = getMessages(locale);
const t = messages.ranking;
const match = messages.aiAssistants.chat.match(91);
---

<section id="features" aria-labelledby="ranking-title" class="section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="ranking-title" lead={t.lead} />

  <div class="container-page rule-t rule-b mt-14 sm:mt-16" data-reveal style="--reveal-delay: 100ms">
    <div class="cells lg:grid-cols-12">
      <!-- The points come first, so the panel beside them covers their
           hairlines as they run across. -->
      <ul class="flex flex-col lg:col-span-5" data-stagger style="--stagger-start: 200ms; --stagger-step: 90ms">
        {
          t.points.map((point, index) => (
            <li class:list={["pad-x flex flex-1 flex-col justify-center gap-2.5 py-7 sm:py-8", index > 0 && "rule-t"]}>
              <h3 class="text-title">{point.title.replace(/[.。．]$/, "")}</h3>
              <p class="leading-relaxed">{point.text}</p>
            </li>
          ))
        }
      </ul>

      <figure class="texture scheme-dark flex flex-col max-lg:rule-t lg:col-span-7 lg:col-start-1 lg:row-start-1">
        <Texture name="panel" />
        <div class="relative flex flex-1 items-center justify-center px-4 pt-20 pb-12 sm:px-10 sm:pt-24 sm:pb-16">
          <div class="shot w-full max-w-[40rem]" data-reveal="blur" style="--reveal-delay: 250ms">
            <Screenshot
              name="match"
              alt={t.screenshotAlt}
              sizes="(min-width: 80rem) 40rem, (min-width: 64rem) 50vw, calc(100vw - 4rem)"
            />
          </div>
          <!-- A floating match, counting up. -->
          <div
            class="float-card absolute top-5 right-5 flex items-center gap-3 border border-white/15 bg-white/10 py-2 pr-4 pl-2 text-white shadow-[0_16px_40px_-12px_rgb(0_0_0/0.5)] backdrop-blur-md sm:top-8 sm:right-8"
            data-reveal
            style="--reveal-delay: 500ms"
            aria-hidden="true"
          >
            <MatchRing value={91} class="size-10" />
            <span class="flex flex-col leading-tight">
              <span class="font-mono text-lg tabular-nums" data-count="91" data-format="percent" data-count-delay="500">
                {formatPercent(91, locale)}
              </span>
              <span class="text-label text-white/70">{match.label}</span>
            </span>
          </div>
        </div>
        <figcaption class="flex items-center gap-3 border-t border-white/10 bg-[#0b0920]/70 px-5 py-4 text-sm text-white/80 backdrop-blur-md sm:px-6">
          <span class="size-1.5 shrink-0 bg-[#a5a8ff]" aria-hidden="true"></span>
          {t.caption(PLAN_FACTS)}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
