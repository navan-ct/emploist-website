---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import Screenshot from "../Screenshot.astro";

const t = getMessages(getLocale(Astro)).ranking;
---

<section id="features" aria-labelledby="ranking-title" class="py-20 sm:py-28">
  <div class="container-page grid items-center gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="text-eyebrow">{t.eyebrow}</p>
      <h2 id="ranking-title" class="text-heading mt-4">{t.title}</h2>
      <p class="text-lead mt-6">{t.lead}</p>
      <ul class="check-list mt-8 flex flex-col gap-4 text-[0.9375rem] leading-relaxed">
        {
          t.points.map((point) => (
            <li>
              <strong class="font-semibold text-ink">{point.title}</strong> {point.text}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="lg:col-span-7">
      <figure class="rounded-3xl bg-subtle p-5 ring-1 ring-line sm:p-8">
        <div class="shot">
          <Screenshot
            name="match"
            alt={t.screenshotAlt}
            sizes="(min-width: 76rem) 40rem, (min-width: 64rem) 52vw, calc(100vw - 5rem)"
          />
        </div>
        <figcaption class="mt-5 text-sm text-faint sm:mt-6">{t.caption(PLAN_FACTS)}</figcaption>
      </figure>
    </div>
  </div>
</section>
