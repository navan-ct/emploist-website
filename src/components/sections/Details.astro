---
import { getLocale, getMessages } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";

const t = getMessages(getLocale(Astro)).details;

// The smaller features' line icons, drawn on a 20 × 20 grid, in the order
// of their words in the messages.
const icons = [
  "M10 3v9m0 0 3.5-3.5M10 12 6.5 8.5M4 13.5V15a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-1.5",
  "M6 2.75h5.5L15 6.25V15.5a1.75 1.75 0 0 1-1.75 1.75h-7.5A1.75 1.75 0 0 1 4 15.5v-11A1.75 1.75 0 0 1 5.75 2.75Zm5 0V6.5h4M7 10.25h6M7 13.25h4",
  "M3 6.5A1.5 1.5 0 0 1 4.5 5h11A1.5 1.5 0 0 1 17 6.5v8a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5v-8ZM7.5 5V3.75A.75.75 0 0 1 8.25 3h3.5a.75.75 0 0 1 .75.75V5M3 10h14",
  "M7 7V4.75A1.75 1.75 0 0 1 8.75 3h6.5A1.75 1.75 0 0 1 17 4.75v6.5A1.75 1.75 0 0 1 15.25 13H13M4.75 7h6.5A1.75 1.75 0 0 1 13 8.75v6.5A1.75 1.75 0 0 1 11.25 17h-6.5A1.75 1.75 0 0 1 3 15.25v-6.5A1.75 1.75 0 0 1 4.75 7Z",
  "M9.5 10a3.25 3.25 0 1 1-6.5 0 3.25 3.25 0 0 1 6.5 0Zm0 0H17m-2.75 0v2.75M17 10v2",
  "M10 2.75 4 5v4.6c0 3.6 2.5 6.4 6 7.65 3.5-1.25 6-4.05 6-7.65V5l-6-2.25ZM7.5 10l1.75 1.75L12.75 8",
  "M5 13.5V9a5 5 0 0 1 10 0v4.5l1.25 1.5H3.75L5 13.5ZM8.25 17.25a1.9 1.9 0 0 0 3.5 0",
  "M10 3.25a6.75 6.75 0 1 0 0 13.5V3.25Zm0 0a6.75 6.75 0 0 1 0 13.5",
];
---

<section aria-labelledby="details-title" class="section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="details-title" />

  <div class="container-page rule-b mt-14 sm:mt-16">
    <ul class="cells sm:grid-cols-2 lg:grid-cols-4" data-stagger style="--stagger-step: 60ms">
      {
        t.items.map((detail, index) => (
          <li class="row-span-3 grid grid-rows-subgrid">
            <div class="rule-t px-5 pt-6 pb-5 max-sm:hidden sm:px-6">
              <svg
                viewBox="0 0 20 20"
                class="size-8 text-ink"
                fill="none"
                stroke="currentColor"
                stroke-width="1.15"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[index]} />
              </svg>
            </div>
            <h3 class="rule-t flex items-center gap-3 bg-surface/70 px-5 py-4 text-[1.25rem] leading-snug tracking-[-0.04em] sm:px-6">
              <svg
                viewBox="0 0 20 20"
                class="size-6 shrink-0 text-ink sm:hidden"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[index]} />
              </svg>
              {detail.title}
            </h3>
            <p class="rule-t px-5 pt-5 pb-7 leading-relaxed sm:px-6">{detail.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
