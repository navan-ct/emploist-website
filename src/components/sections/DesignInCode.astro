---
import { getLocale, getMessages } from "../../i18n";
import Screenshot from "../Screenshot.astro";
import Window from "../Window.astro";

const t = getMessages(getLocale(Astro)).designInCode;
---

<section aria-labelledby="code-title" class="scheme-dark overflow-hidden py-20 sm:py-28">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <p class="text-eyebrow">{t.eyebrow}</p>
        <h2 id="code-title" class="text-heading mt-4">{t.title}</h2>
        <p class="text-lead mt-6">{t.lead}</p>
      </div>
      <ul class="check-list flex flex-col gap-4 self-end text-[0.9375rem] leading-relaxed lg:col-span-5 lg:col-start-8">
        {t.points.map((point) => <li>{point}</li>)}
      </ul>
    </div>

    <Window class="mt-14 sm:mt-16">
      <Screenshot
        name="careers-code"
        scheme="dark"
        alt={t.screenshotAlt}
        sizes="(min-width: 76rem) 72rem, calc(100vw - 2.5rem)"
      />
    </Window>
  </div>
</section>
