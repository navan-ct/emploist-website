---
import { FAQ } from "../../lib/faq";
import { SITE } from "../../lib/site";
---

<section id="faq" aria-labelledby="faq-title" class="border-t border-line py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="text-eyebrow">FAQ</p>
      <h2 id="faq-title" class="text-heading mt-4">Questions, answered.</h2>
      <p class="mt-6 leading-relaxed">
        Can't find what you're looking for? Email us at{" "}
        <a href={`mailto:${SITE.supportEmail}`} class="font-medium text-brand-ink underline-offset-4 hover:underline"
          >{SITE.supportEmail}</a
        >{" "}
        and we'll get back to you.
      </p>
    </div>
    <div class="lg:col-span-8">
      <div class="border-t border-line">
        {
          FAQ.map((item) => (
            <details class="group border-b border-line" name="faq">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-[1.0625rem] font-medium text-ink [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  viewBox="0 0 20 20"
                  class="mt-1 size-4.5 shrink-0 text-faint transition-transform duration-200 group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M10 4v12M4 10h12" />
                </svg>
              </summary>
              <p class="max-w-2xl pb-6 leading-relaxed">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
