---
import { getLocale, getMessages, linkTo, PLAN_FACTS } from "../../i18n";
import { SITE } from "../../lib/site";

const t = getMessages(getLocale(Astro)).faq;
const email = linkTo(`mailto:${SITE.supportEmail}`)(SITE.supportEmail);
---

<section id="faq" aria-labelledby="faq-title" class="border-t border-line py-20 sm:py-28">
  <div class="container-page grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <p class="text-eyebrow">{t.eyebrow}</p>
      <h2 id="faq-title" class="text-heading mt-4">{t.title}</h2>
      <p
        class="mt-6 leading-relaxed [&_a]:font-medium [&_a]:text-brand-ink [&_a]:underline-offset-4 [&_a:hover]:underline"
        set:html={t.intro(email)}
      />
    </div>
    <div class="lg:col-span-8">
      <div class="border-t border-line">
        {
          t.items(PLAN_FACTS).map((item) => (
            <details class="group border-b border-line" name="faq">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 text-left text-[1.0625rem] font-medium text-ink [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  viewBox="0 0 20 20"
                  class="mt-1 size-4.5 shrink-0 text-faint transition-transform duration-200 group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M10 4v12M4 10h12" />
                </svg>
              </summary>
              <p class="max-w-2xl pb-6 leading-relaxed">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
