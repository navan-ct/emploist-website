---
import { getLocale, getMessages } from "../../i18n";
import SectionHeader from "../SectionHeader.astro";
import StepVisual from "../StepVisual.astro";

const t = getMessages(getLocale(Astro)).howItWorks;
---

<section id="how-it-works" aria-labelledby="how-title" class="section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="how-title" />

  <div class="container-page rule-b mt-14 sm:mt-16">
    <ol class="cells sm:grid-cols-2 lg:grid-cols-4" data-stagger style="--stagger-step: 110ms">
      {
        t.steps.map((step, index) => (
          <li class="row-span-4 grid grid-rows-subgrid">
            <p class="rule-t flex items-center px-5 py-4 max-sm:hidden" aria-hidden="true">
              <span class="tag tag-solid">{String(index + 1).padStart(2, "0")}</span>
            </p>
            <h3 class="text-title rule-t flex items-center gap-3 px-5 py-5">
              <span class="tag tag-solid sm:hidden" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              {step.title}
            </h3>
            <div class="rule-t h-52 sm:h-56">
              <StepVisual step={index} />
            </div>
            <p class="rule-t px-5 pt-5 pb-7 leading-relaxed text-ink/75">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
