---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import { formatUsd } from "../../i18n/format";
import { APP, CREDIT_PACKS, PLAN, YEARLY_SAVINGS } from "../../lib/site";
import Button from "../Button.astro";

const locale = getLocale(Astro);
const t = getMessages(locale).pricing;

// The toggle is two radio buttons; the card shows the checked one's price
// and credits with CSS (`:has`), so it works without a script.
const intervals = [
  {
    id: "billing-monthly",
    label: t.monthly,
    price: formatUsd(PLAN.priceUsd, locale),
    per: t.perMonth,
    credits: t.monthlyCredits(PLAN.credits),
  },
  {
    id: "billing-yearly",
    label: t.yearly,
    note: t.save(YEARLY_SAVINGS),
    price: formatUsd(PLAN.yearlyPriceUsd, locale),
    per: t.perYear,
    credits: t.yearlyCredits(PLAN.yearlyCredits),
  },
];
---

<section id="pricing" aria-labelledby="pricing-title" class="border-t border-line py-20 sm:py-28">
  <div class="container-page grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <p class="text-eyebrow">{t.eyebrow}</p>
      <h2 id="pricing-title" class="text-heading mt-4">{t.title}</h2>
      <p class="text-lead mt-6">{t.lead}</p>
      <div class="mt-10 border-t border-line pt-6">
        <h3 class="font-semibold">{t.creditTitle}</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed">{t.creditText(PLAN_FACTS)}</p>
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="overflow-hidden rounded-3xl border border-line bg-raised shadow-[var(--shot-shadow)]">
        <div class="group/plan p-8 sm:p-10">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h3 class="text-sm font-semibold text-brand-ink">Emploist</h3>
            <fieldset class="w-full sm:w-auto">
              <legend class="sr-only">{t.billing}</legend>
              <div class="flex rounded-full bg-subtle p-1 ring-1 ring-line">
                {
                  intervals.map((interval, index) => (
                    <label class="flex h-9 flex-1 cursor-pointer items-center justify-center gap-2 rounded-full px-2 text-sm font-medium whitespace-nowrap sm:px-4 text-body transition-colors duration-150 hover:text-ink has-checked:bg-raised has-checked:text-ink has-checked:shadow-[0_1px_2px_oklch(0%_0_0/0.08),0_0_0_1px_var(--line)] has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring">
                      <input type="radio" name="billing" id={interval.id} checked={index === 0} class="sr-only" />
                      {interval.label}
                      {interval.note && (
                        <span class="rounded-full bg-brand-soft px-1.5 py-0.5 sm:px-2 text-xs font-semibold text-brand-ink">
                          {interval.note}
                        </span>
                      )}
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>

          <div class="mt-8 flex flex-wrap items-end justify-between gap-x-3 gap-y-6">
            <div class="grid">
              {
                intervals.map((interval, index) => (
                  <p
                    class:list={[
                      "col-start-1 row-start-1 flex flex-wrap items-baseline gap-x-1.5 text-ink",
                      index === 0
                        ? "group-has-[#billing-yearly:checked]/plan:invisible"
                        : "invisible group-has-[#billing-yearly:checked]/plan:visible",
                    ]}
                  >
                    <span class="text-6xl font-semibold tracking-[-0.045em]">{interval.price}</span>
                    <span class="text-body">{interval.per}</span>
                  </p>
                ))
              }
            </div>
            <Button href={APP.signUpUrl} size="lg" class="w-full max-sm:h-auto max-sm:min-h-12 max-sm:py-3 max-sm:text-center max-sm:leading-snug max-sm:whitespace-normal sm:w-auto">
              {t.startTrial(PLAN.trialDays)}
            </Button>
          </div>

          <ul class="check-list mt-10 grid gap-x-8 gap-y-3.5 text-[0.9375rem] text-ink sm:grid-cols-2">
            {
              intervals.map((interval, index) => (
                <li
                  class={
                    index === 0
                      ? "group-has-[#billing-yearly:checked]/plan:hidden"
                      : "hidden group-has-[#billing-yearly:checked]/plan:block"
                  }
                >
                  {interval.credits}
                </li>
              ))
            }
            {t.included.map((item) => <li>{item}</li>)}
          </ul>

          <p
            class="mt-10 rounded-xl bg-subtle px-5 py-4 text-sm leading-relaxed ring-1 ring-line [&_strong]:font-semibold [&_strong]:text-ink"
            set:html={t.trial(PLAN_FACTS)}
          />
        </div>

        <div class="border-t border-line bg-subtle p-8 sm:px-10">
          <h3 class="font-semibold">{t.moreCredits}</h3>
          <p class="mt-1 text-sm">{t.packsNote}</p>
          <table class="mt-5 w-full text-[0.9375rem]">
            <caption class="sr-only">{t.packsCaption}</caption>
            <thead class="sr-only">
              <tr><th scope="col">{t.creditsColumn}</th><th scope="col">{t.priceColumn}</th></tr>
            </thead>
            <tbody class="divide-y divide-line">
              {
                CREDIT_PACKS.map((pack) => (
                  <tr>
                    <th scope="row" class="py-3 text-left font-normal text-ink">
                      {t.packCredits(pack.credits)}
                    </th>
                    <td class="py-3 text-right font-medium text-ink tabular-nums">{formatUsd(pack.priceUsd, locale)}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
