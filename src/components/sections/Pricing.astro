---
import { getLocale, getMessages, PLAN_FACTS } from "../../i18n";
import { formatUsd } from "../../i18n/format";
import { APP, CREDIT_PACKS, PLAN, YEARLY_SAVINGS } from "../../lib/site";
import Button from "../Button.astro";
import SectionHeader from "../SectionHeader.astro";
import Wordmark from "../Wordmark.astro";

const locale = getLocale(Astro);
const t = getMessages(locale).pricing;

// The toggle is two radio buttons; the plan shows the checked one's price
// and credits with CSS (`:has`), so it works without a script.
const intervals = [
  {
    id: "billing-monthly",
    label: t.monthly,
    price: formatUsd(PLAN.priceUsd, locale),
    per: t.perMonth,
    credits: t.monthlyCredits(PLAN.credits),
  },
  {
    id: "billing-yearly",
    label: t.yearly,
    note: t.save(YEARLY_SAVINGS),
    price: formatUsd(PLAN.yearlyPriceUsd, locale),
    per: t.perYear,
    credits: t.yearlyCredits(PLAN.yearlyCredits),
  },
];
---

<section id="pricing" aria-labelledby="pricing-title" class="group/plan section-y">
  <SectionHeader eyebrow={t.eyebrow} title={t.title} id="pricing-title" lead={t.lead}>
    <fieldset class="mt-4 w-full max-w-sm sm:w-auto sm:max-w-none">
      <legend class="sr-only">{t.billing}</legend>
      <div class="relative grid grid-cols-2 border border-line bg-subtle p-1">
        <span
          class="absolute inset-y-1 left-1 w-[calc(50%-0.25rem)] bg-raised shadow-[0_1px_2px_rgb(13_13_13/0.08),0_0_0_1px_var(--line)] transition-transform duration-500 ease-(--ease-out) group-has-[#billing-yearly:checked]/plan:translate-x-full"
          aria-hidden="true"></span>
        {
          intervals.map((interval, index) => (
            <label class="text-label relative flex h-10 cursor-pointer items-center justify-center gap-2 px-3 whitespace-nowrap text-body transition-colors duration-300 hover:text-ink has-checked:text-ink has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-ring sm:px-5">
              <input type="radio" name="billing" id={interval.id} checked={index === 0} class="sr-only" />
              {interval.label}
              {interval.note && <span class="bg-brand px-1.5 py-0.5 text-[0.6875rem] text-white">{interval.note}</span>}
            </label>
          ))
        }
      </div>
    </fieldset>
  </SectionHeader>

  <div class="container-page rule-t rule-b mt-14 sm:mt-16" data-reveal style="--reveal-delay: 100ms">
    <div class="cells lg:grid-cols-12">
      <!-- The plan: its price, and how to start. -->
      <div class="flex flex-col lg:col-span-5">
        <div class="flex h-16 items-center bg-subtle px-5 sm:px-8">
          <h3><Wordmark /></h3>
        </div>
        <div class="grid overflow-hidden border-t border-line px-5 py-8 sm:px-8 sm:py-10">
          {
            intervals.map((interval, index) => (
              <p
                class:list={[
                  "col-start-1 row-start-1 flex flex-wrap items-baseline gap-x-2 text-ink transition-[opacity,translate,visibility,filter] duration-500 ease-(--ease-out)",
                  index === 0
                    ? "group-has-[#billing-yearly:checked]/plan:invisible group-has-[#billing-yearly:checked]/plan:-translate-y-4 group-has-[#billing-yearly:checked]/plan:opacity-0 group-has-[#billing-yearly:checked]/plan:blur-sm"
                    : "invisible translate-y-4 opacity-0 blur-sm group-has-[#billing-yearly:checked]/plan:visible group-has-[#billing-yearly:checked]/plan:translate-y-0 group-has-[#billing-yearly:checked]/plan:opacity-100 group-has-[#billing-yearly:checked]/plan:blur-none",
                ]}
              >
                <span class="text-[clamp(3.5rem,2.8rem+2.5vw,4.75rem)] leading-none tracking-[-0.06em]">{interval.price}</span>
                <span class="text-lg tracking-[-0.03em] text-body">/ {interval.per}</span>
              </p>
            ))
          }
        </div>
        <div class="border-t border-line px-5 py-5 sm:px-8">
          <Button
            href={APP.signUpUrl}
            size="lg"
            class="w-full max-sm:h-auto max-sm:min-h-13 max-sm:py-3 max-sm:text-center max-sm:leading-snug max-sm:whitespace-normal"
          >
            {t.startTrial(PLAN.trialDays)}
          </Button>
        </div>
        <p
          class="flex-1 border-t border-line bg-subtle px-5 py-5 text-sm leading-relaxed sm:px-8 [&_strong]:font-medium [&_strong]:text-ink"
          set:html={t.trial(PLAN_FACTS)}
        />
      </div>

      <!-- Everything that's in it. -->
      <ul data-stagger style="--stagger-start: 250ms; --stagger-step: 50ms" class="check-list grid content-center gap-x-8 gap-y-4 px-5 py-8 text-[0.9375rem] tracking-[-0.015em] text-ink max-lg:border-t max-lg:border-line sm:grid-cols-2 sm:px-8 sm:py-10 lg:col-span-7">
        {
          intervals.map((interval, index) => (
            <li
              class={
                index === 0
                  ? "group-has-[#billing-yearly:checked]/plan:hidden"
                  : "hidden group-has-[#billing-yearly:checked]/plan:block"
              }
            >
              {interval.credits}
            </li>
          ))
        }
        {t.included.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <!-- AI credits: what they are, and packs of more. -->
    <div class="cells lg:grid-cols-12">
      <div class="rule-t px-5 py-8 sm:px-8 lg:col-span-5">
        <h3 class="text-title">{t.creditTitle}</h3>
        <p class="mt-3 leading-relaxed">{t.creditText(PLAN_FACTS)}</p>
      </div>
      <div class="rule-t flex flex-col lg:col-span-7">
        <div class="px-5 pt-8 pb-6 sm:px-8">
          <h3 class="text-title">{t.moreCredits}</h3>
          <p class="mt-2 text-[0.9375rem]">{t.packsNote}</p>
        </div>
        <ul aria-label={t.packsCaption} class="cells mt-auto grid-cols-3 border-t border-line">
          {
            CREDIT_PACKS.map((pack) => (
              <li class="flex flex-col gap-3 bg-subtle px-4 py-5 sm:px-8">
                <span class="text-label text-body">{t.packCredits(pack.credits)}</span>
                <span class="text-[1.75rem] leading-none tracking-[-0.05em] text-ink tabular-nums">
                  {formatUsd(pack.priceUsd, locale)}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
