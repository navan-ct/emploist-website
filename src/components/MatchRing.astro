---
// A ring that fills to a match, like the app's, when it comes into view.
interface Props {
  /** 0 to 100. */
  value: number;
  class?: string;
}

const { value, class: className } = Astro.props;
const circumference = 2 * Math.PI * 16;
---

<svg viewBox="0 0 40 40" class:list={["match-ring -rotate-90", className]} data-play aria-hidden="true">
  <circle cx="20" cy="20" r="16" fill="none" stroke="currentColor" stroke-opacity="0.2" stroke-width="4"></circle>
  <circle
    cx="20"
    cy="20"
    r="16"
    fill="none"
    stroke="#34d399"
    stroke-width="4"
    stroke-linecap="round"
    stroke-dasharray={circumference}
    stroke-dashoffset={circumference * (1 - value / 100)}
    style={`--from: ${circumference}`}></circle>
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .match-ring circle + circle {
      animation: ring-fill 1.6s var(--ease-out) 0.5s both;
    }

    @keyframes ring-fill {
      from {
        stroke-dashoffset: var(--from);
      }
    }
  }
</style>
