---
import { getMessages } from "../i18n";
import { DEFAULT_LOCALE, type Locale, LOCALES, REGIONAL_LOCALES } from "../i18n/locales";
import { SITE } from "../lib/site";

export interface SeoProps {
  title: string;
  description: string;
  /** An absolute or root-relative image for link previews. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Structured data (schema.org), one script per object. */
  jsonLd?: Record<string, unknown>[];
}

interface Props extends SeoProps {
  locale: Locale;
  /** The page's address in each language it's in, including this one. */
  alternates: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  image = "/og.png",
  imageAlt,
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd = [],
  locale,
  alternates,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const previewAlt = imageAlt ?? getMessages(locale).site.imageAlt;
const ogLocale = (option: Locale) => REGIONAL_LOCALES[option].replace("-", "_");
// Search engines show each visitor the page in their language. English is
// the default for everyone else.
const languages = noindex ? [] : LOCALES.filter((option) => alternates[option]);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
{languages.map((option) => <link rel="alternate" hreflang={option} href={new URL(alternates[option]!, Astro.site)} />)}
{
  languages.length > 1 && alternates[DEFAULT_LOCALE] && (
    <link rel="alternate" hreflang="x-default" href={new URL(alternates[DEFAULT_LOCALE], Astro.site)} />
  )
}

<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:locale" content={ogLocale(locale)} />
{
  languages
    .filter((option) => option !== locale)
    .map((option) => <meta property="og:locale:alternate" content={ogLocale(option)} />)
}
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={previewAlt} />
{image === "/og.png" && <meta property="og:image:width" content="1200" />}
{image === "/og.png" && <meta property="og:image:height" content="630" />}
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={previewAlt} />

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />)}
