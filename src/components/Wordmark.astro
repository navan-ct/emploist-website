---
// The mark (a ranked list of bars on an indigo tile) and the name. Same
// shapes as the app's `components/wordmark.tsx` and public/favicon.svg.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5 text-[1.3125rem] font-medium tracking-[-0.045em] text-ink", className]}>
  <svg viewBox="0 0 64 64" aria-hidden="true" class="size-7 shrink-0">
    <rect width="64" height="64" rx="16" fill="#4f46e5"></rect>
    <g fill="#fff">
      <rect x="15" y="17" width="34" height="8" rx="4"></rect>
      <rect x="15" y="28" width="24" height="8" rx="4" opacity="0.7"></rect>
      <rect x="15" y="39" width="14" height="8" rx="4" opacity="0.42"></rect>
    </g>
  </svg>
  <span>Emploist</span>
</span>
