import LegalLayout from "../../layouts/LegalLayout.astro";
import { SITE } from "../../lib/site";

const sections = [
  { id: "about", title: "Acerca de estos Términos" },
  { id: "accounts", title: "Su cuenta y su equipo" },
  { id: "service", title: "El servicio" },
  { id: "ai-ranking", title: "Evaluación con IA" },
  { id: "ai-assistants", title: "Asistentes de IA" },
  { id: "plans-and-payments", title: "Planes, pagos y cancelación" },
  { id: "your-content", title: "Datos del Cliente" },
  { id: "acceptable-use", title: "Uso aceptable" },
  { id: "careers-pages", title: "Páginas de empleo, dominios y código" },
  { id: "third-party-services", title: "Servicios de terceros" },
  { id: "our-property", title: "Propiedad intelectual" },
  { id: "confidentiality", title: "Confidencialidad" },
  { id: "data-processing", title: "Tratamiento de datos" },
  { id: "suspension-and-termination", title: "Suspensión y terminación" },
  { id: "disclaimers", title: "Exclusión de garantías" },
  { id: "liability", title: "Limitación de responsabilidad" },
