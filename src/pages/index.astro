---
import CallToAction from "../components/CallToAction.astro";
import CareersPage from "../components/sections/CareersPage.astro";
import Details from "../components/sections/Details.astro";
import DesignInCode from "../components/sections/DesignInCode.astro";
import Faq from "../components/sections/Faq.astro";
import FormsAndTeam from "../components/sections/FormsAndTeam.astro";
import Hero from "../components/sections/Hero.astro";
import HowItWorks from "../components/sections/HowItWorks.astro";
import Pricing from "../components/sections/Pricing.astro";
import Ranking from "../components/sections/Ranking.astro";
import StagesAndEmails from "../components/sections/StagesAndEmails.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { FAQ } from "../lib/faq";
import { APP, PLAN, SITE } from "../lib/site";

const organizationId = `${SITE.url}/#organization`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": organizationId,
        name: SITE.name,
        url: `${SITE.url}/`,
        logo: `${SITE.url}/apple-touch-icon.png`,
        email: SITE.supportEmail,
      },
      {
        "@type": "WebSite",
        "@id": `${SITE.url}/#website`,
        name: SITE.name,
        url: `${SITE.url}/`,
        publisher: { "@id": organizationId },
      },
      {
        "@type": "SoftwareApplication",
        name: SITE.name,
        url: `${SITE.url}/`,
        applicationCategory: "BusinessApplication",
        applicationSubCategory: "Applicant tracking system",
        operatingSystem: "Web",
        description: SITE.description,
        publisher: { "@id": organizationId },
        offers: [
          {
            "@type": "Offer",
            price: String(PLAN.priceUsd),
            priceCurrency: "USD",
            url: APP.signUpUrl,
            description: `${PLAN.trialDays}-day free trial, then $${PLAN.priceUsd} a month for the whole team.`,
          },
          {
            "@type": "Offer",
            price: String(PLAN.yearlyPriceUsd),
            priceCurrency: "USD",
            url: APP.signUpUrl,
            description: `${PLAN.trialDays}-day free trial, then $${PLAN.yearlyPriceUsd} a year for the whole team.`,
          },
        ],
      },
      {
        "@type": "FAQPage",
        mainEntity: FAQ.map((item) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: { "@type": "Answer", text: item.answer },
        })),
      },
    ],
  },
];
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <Hero />
  <HowItWorks />
  <Ranking />
  <CareersPage />
  <DesignInCode />
  <FormsAndTeam />
  <StagesAndEmails />
  <Details />
  <Pricing />
  <Faq />
  <CallToAction />
</BaseLayout>
