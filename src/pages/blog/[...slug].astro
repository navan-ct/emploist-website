---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Button from "../../components/Button.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, type Post, postUrl, readingMinutes } from "../../lib/blog";
import { APP, PLAN, SITE } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, author, image, imageAlt, tags } = post.data;
const url = `${SITE.url}${postUrl(post)}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { "@type": "Organization", name: author, url: `${SITE.url}/` },
    publisher: {
      "@type": "Organization",
      name: SITE.name,
      url: `${SITE.url}/`,
      logo: { "@type": "ImageObject", url: `${SITE.url}/apple-touch-icon.png` },
    },
    ...(image && { image: new URL(image.src, SITE.url).href }),
    ...(tags.length > 0 && { keywords: tags.join(", ") }),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: "Blog", item: `${SITE.url}/blog/` },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
---

<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  type="article"
  image={image?.src}
  imageAlt={imageAlt ?? title}
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  noindex={post.data.draft}
  jsonLd={jsonLd}
>
  <article class="container-page pt-12 pb-20 sm:pt-16 sm:pb-28">
    <div class="mx-auto max-w-[44rem]">
      <nav aria-label="Breadcrumb">
        <a href="/blog/" class="text-[0.9375rem] font-medium text-faint transition-colors hover:text-ink">← Blog</a>
      </nav>

      <header class="mt-10">
        <p class="text-sm text-faint">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true"> · </span>
          {readingMinutes(post)} min read
          {
            updatedDate && (
              <>
                <span aria-hidden="true"> · </span>
                Updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
              </>
            )
          }
        </p>
        <h1 class="text-heading mt-4">{title}</h1>
        <p class="text-lead mt-5">{description}</p>
        <p class="mt-6 text-[0.9375rem] font-medium text-ink">{author}</p>
      </header>
    </div>

    {
      image && (
        <div class="mx-auto mt-12 max-w-5xl overflow-hidden rounded-3xl border border-line bg-subtle">
          <Image
            src={image}
            alt={imageAlt ?? ""}
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 64rem) 64rem, 100vw"
            loading="eager"
            fetchpriority="high"
            class="w-full"
          />
        </div>
      )
    }

    <div class="prose-post prose prose-zinc mx-auto mt-12 max-w-[44rem] sm:prose-lg">
      <Content />
    </div>

    <aside
      aria-label="Try Emploist"
      class="mx-auto mt-16 flex max-w-[44rem] flex-col gap-6 rounded-3xl border border-line bg-subtle p-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div>
        <p class="font-semibold text-ink">See your best applicants first.</p>
        <p class="mt-1 text-[0.9375rem]">
          Try Emploist free for {PLAN.trialDays} days, then ${PLAN.priceUsd} a month for your whole team.
        </p>
      </div>
      <Button href={APP.signUpUrl}>Start free trial</Button>
    </aside>
  </article>
</BaseLayout>
