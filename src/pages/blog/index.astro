---
import { Image } from "astro:assets";
import Button from "../../components/Button.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPosts, postUrl, readingMinutes } from "../../lib/blog";
import { APP, SITE } from "../../lib/site";

const posts = await getPosts();
const title = `Blog | ${SITE.name}`;
const description = "Guides on hiring, careers pages, and applicant tracking, plus product updates from the Emploist team.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Blog",
    name: `${SITE.name} blog`,
    url: `${SITE.url}/blog/`,
    description,
    publisher: { "@type": "Organization", name: SITE.name, url: `${SITE.url}/` },
    blogPost: posts.map((post) => ({
      "@type": "BlogPosting",
      headline: post.data.title,
      url: `${SITE.url}${postUrl(post)}`,
      datePublished: post.data.pubDate.toISOString(),
    })),
  },
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="container-page pt-16 pb-20 sm:pt-24 sm:pb-28">
    <header class="max-w-2xl">
      <p class="text-eyebrow">Blog</p>
      <h1 class="text-display mt-4">Notes on hiring well.</h1>
      <p class="text-lead mt-6">{description}</p>
    </header>

    {
      posts.length === 0 ? (
        <div class="mt-16 rounded-3xl border border-line bg-subtle px-8 py-14 sm:px-12">
          <h2 class="text-subheading">The first posts are on their way.</h2>
          <p class="mt-3 max-w-xl leading-relaxed">
            We're writing guides on hiring and getting the most out of Emploist. Follow along with the{" "}
            <a href="/rss.xml" class="font-medium text-brand-ink underline-offset-4 hover:underline">
              RSS feed
            </a>
            , or start your free trial in the meantime.
          </p>
          <div class="mt-8">
            <Button href={APP.signUpUrl}>Start your free trial</Button>
          </div>
        </div>
      ) : (
        <ul class="mt-16 grid gap-x-8 gap-y-14 border-t border-line pt-14 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <li>
              <article class="group relative flex flex-col">
                {post.data.image && (
                  <div class="mb-6 overflow-hidden rounded-2xl border border-line bg-subtle">
                    <Image
                      src={post.data.image}
                      alt={post.data.imageAlt ?? ""}
                      widths={[400, 640, 800]}
                      sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 50vw, 100vw"
                      class="aspect-[1200/630] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                    />
                  </div>
                )}
                <p class="text-sm text-faint">
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span aria-hidden="true"> · </span>
                  {readingMinutes(post)} min read
                  {post.data.draft && <span class="ml-2 rounded bg-amber-100 px-1.5 py-0.5 text-xs text-amber-800">Draft</span>}
                </p>
                <h2 class="mt-3 text-xl font-semibold tracking-[-0.015em]">
                  <a href={postUrl(post)} class="after:absolute after:inset-0">
                    {post.data.title}
                  </a>
                </h2>
                <p class="mt-3 leading-relaxed">{post.data.description}</p>
                <span class="mt-4 text-[0.9375rem] font-medium text-brand-ink" aria-hidden="true">
                  Read the post →
                </span>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
